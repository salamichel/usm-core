{% extends 'admin/layout.twig' %}
{% import 'admin/_macros.twig' as m %}

{% block content %}
<div class="space-y-6 max-w-4xl">
  {{ m.page_header(
    team.id ? 'Modifier l\'équipe adverse' : 'Nouvelle équipe adverse',
    null,
    null,
    [
      { label: 'Référentiel Adversaires', url: url('admin/opponent-teams') },
      { label: team.id ? team.name : 'Création' }
    ]
  ) }}

  {{ m.form_error(error) }}

  <div class="bg-white rounded-3xl p-6 md:p-8 border border-slate-100 shadow-sm space-y-8">
    <form method="POST" action="{{ action }}" class="space-y-6">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-2">
          {{ m.field_input('name', 'name', 'Nom complet de l\'équipe', team.name, 'text', true, 'ex: VB Club Toulonnais 1') }}
        </div>
        <div>
          {{ m.field_input('club', 'club', 'Club ou association', team.club, 'text', false, 'ex: VBC Toulon') }}
        </div>
        <div>
          {{ m.field_input('city', 'city', 'Ville', team.city, 'text', false, 'ex: Toulon') }}
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-6 pt-2 border-t border-slate-100">
        {{ m.field_checkbox('is_active', 'is_active', 'Équipe active (proposée dans les formulaires)', team.is_active) }}
        {{ m.field_checkbox('needs_review', 'needs_review', 'Marquer comme nécessitant une vérification', team.needs_review) }}
      </div>

      <div class="pt-4 flex items-center justify-between">
        <a href="{{ url('admin/opponent-teams') }}" class="text-sm font-semibold text-slate-500 hover:text-slate-800 transition">
          ← Retour à la liste
        </a>
        {{ m.btn_submit('Enregistrer') }}
      </div>
    </form>
  </div>

  {% if team.id and allTeams|length > 1 %}
    <div class="bg-white rounded-3xl p-6 md:p-8 border border-amber-200/60 shadow-sm space-y-4">
      <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
        <svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
        Fusionner cette équipe avec un doublon
      </h2>
      <p class="text-sm text-slate-600">
        Tous les scores et matchs associés à <strong>{{ team.name }}</strong> seront automatiquement réaffectés à l'équipe sélectionnée ci-dessous, puis <strong>{{ team.name }}</strong> sera supprimée.
      </p>

      <form method="POST" action="{{ url('admin/opponent-teams/' ~ team.id ~ '/merge') }}"
            data-confirm="Êtes-vous sûr de vouloir fusionner cette équipe ? Cette opération est irréversible."
            class="flex flex-col sm:flex-row gap-4 items-end">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
        
        <div class="flex-1 w-full">
          <label class="block text-sm font-bold text-slate-700 mb-1.5" for="target_team_id">
            Équipe cible qui conserve les scores
          </label>
          <select id="target_team_id" name="target_team_id" required
                  class="w-full border border-slate-200 bg-white rounded-xl px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#94674d]/20 focus:border-[#94674d]">
            <option value="">-- Sélectionner l'équipe principale --</option>
            {% for other in allTeams %}
              {% if other.id != team.id %}
                <option value="{{ other.id }}">{{ other.name }} {% if other.city %}({{ other.city }}){% endif %}</option>
              {% endif %}
            {% endfor %}
          </select>
        </div>

        <button type="submit"
                class="inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white font-bold px-5 py-2.5 rounded-xl text-sm transition shadow-sm">
          Fusionner
        </button>
      </form>
    </div>
  {% endif %}
</div>
{% endblock %}
