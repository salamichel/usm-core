{% extends 'admin/layout.twig' %}
{% import 'admin/_macros.twig' as m %}
{% block title %}{{ manifestation ? 'Éditer' : 'Créer' }} une manifestation{% endblock %}

{% block content %}

{# ── En-tête avec breadcrumb ── #}
<div class="relative overflow-hidden bg-slate-900 rounded-3xl p-6 md:p-8 text-white shadow-sm mb-8">
  <div class="relative">
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 font-medium mb-2">
      <a href="{{ url('admin') }}" class="hover:text-white transition">Admin</a>
      <svg class="w-3 h-3 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      <a href="{{ url('admin/manifestations') }}" class="hover:text-white transition">Manifestations</a>
      <svg class="w-3 h-3 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      <span class="text-slate-200">{{ manifestation ? 'Éditer' : 'Nouvelle manifestation' }}</span>
    </nav>
    <h1 class="text-2xl font-black tracking-tight">
      {{ manifestation ? 'Éditer la manifestation' : 'Nouvelle manifestation' }}
    </h1>
  </div>
</div>

{{ m.form_error(error) }}

<form method="POST" action="{{ action }}" class="space-y-6">
  <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

  <div class="bg-white border border-slate-100 rounded-3xl shadow-sm p-6 md:p-8 space-y-6">
    <h2 class="font-bold text-base text-slate-800 border-b border-slate-100 pb-3">Détails de la manifestation</h2>

    <div class="grid sm:grid-cols-2 gap-6">
      {# Type de manifestation #}
      <div class="sm:col-span-2">
        <label class="block text-sm font-bold text-slate-700 mb-1.5" for="manifestation_type">Type de manifestation *</label>
        <select id="manifestation_type" name="manifestation_type" required
                class="w-full border border-slate-200 bg-white rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#94674d]/20 focus:border-[#94674d] transition">
          <option value="">-- Sélectionner un type --</option>
          {% for type in types %}
            <option value="{{ type }}" {{ manifestation.manifestation_type == type ? 'selected' : '' }}>{{ type }}</option>
          {% endfor %}
        </select>
      </div>

      {# Date #}
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-1.5" for="date">Date & Heure *</label>
        <input type="datetime-local" id="date" name="date" required
               value="{{ manifestation.date ?? '' }}"
               class="w-full border border-slate-200 bg-white rounded-xl px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#94674d]/20 focus:border-[#94674d] transition">
      </div>

      {# Durée #}
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-1.5" for="duration">Durée *</label>
        <select id="duration" name="duration" required
                class="w-full border border-slate-200 bg-white rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#94674d]/20 focus:border-[#94674d] transition">
          <option value="">-- Sélectionner une durée --</option>
          {% for dur in durations %}
            <option value="{{ dur }}" {{ manifestation.duration == dur ? 'selected' : '' }}>{{ dur }}</option>
          {% endfor %}
        </select>
      </div>

      {# Lieu #}
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-1.5" for="location">Lieu *</label>
        <select id="location" name="location" required
                class="w-full border border-slate-200 bg-white rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#94674d]/20 focus:border-[#94674d] transition">
          <option value="">-- Sélectionner un lieu --</option>
          {% for loc in locations %}
            <option value="{{ loc }}" {{ manifestation.location == loc ? 'selected' : '' }}>{{ loc }}</option>
          {% endfor %}
        </select>
      </div>

      {# Nombre de terrains #}
      <div>
        {{ m.field_input('nombre_terrain', 'nombre_terrain', 'Nombre de terrains', manifestation.nombre_terrain ?? 1, 'number', true) }}
      </div>

      {# Statut #}
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-1.5" for="statut">Statut *</label>
        <select id="statut" name="statut" required
                class="w-full border border-slate-200 bg-white rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#94674d]/20 focus:border-[#94674d] transition">
          {% for status in statuses %}
            <option value="{{ status }}" {{ (manifestation.statut ?? 'Confirmé') == status ? 'selected' : '' }}>{{ status }}</option>
          {% endfor %}
        </select>
      </div>

      {# Commentaire #}
      <div class="sm:col-span-2">
        {{ m.field_textarea('commentaire', 'commentaire', 'Commentaire (optionnel)', manifestation.commentaire ?? '', 3, false, 'Ex: Contre Pessac...') }}
      </div>

      {# Notification Email #}
      {% if not manifestation or not manifestation.id %}
      <div class="sm:col-span-2 pt-2 border-t border-slate-50">
        {{ m.field_checkbox('send_notification_email', 'send_notification_email', 'Envoyer une notification par e-mail aux abonnés', manifestation is null or manifestation.send_notification_email, '1') }}
      </div>
      {% endif %}
    </div>
  </div>

  {# ── Section Rencontre & Score (Pour les matchs) ── #}
  <div class="bg-white border border-slate-100 rounded-3xl shadow-sm p-6 md:p-8 space-y-6">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div>
        <h2 class="font-bold text-base text-slate-800">Équipe adverse & Score (Rencontres officielles)</h2>
        <p class="text-xs text-slate-500 mt-0.5">Renseignez l'adversaire et les scores si cet événement est un match officiel.</p>
      </div>
      {% if current_encounters|length > 1 %}
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
          🎪 Plateau multi-équipes ({{ current_encounters|length }} rencontres)
        </span>
      {% elseif match_result and match_result.sets_for is not null and match_result.sets_against is not null %}
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
          Score saisi : {{ match_result.sets_for }} - {{ match_result.sets_against }}
        </span>
      {% endif %}
    </div>

    {% if current_encounters|length > 1 %}
      {# Plateau multi-équipes #}
      <div class="space-y-4">
        {% for enc in current_encounters %}
          <div class="p-4 bg-slate-50 border border-slate-200 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <span class="text-xs font-bold text-amber-600 block">Rencontre {{ loop.index }}</span>
              <span class="font-bold text-slate-800 text-sm">vs {{ enc.opponent_name }}</span>
              {% if enc.opponent_club or enc.opponent_city %}
                <span class="text-xs text-slate-500 block">{{ enc.opponent_club }}{% if enc.opponent_club and enc.opponent_city %} · {% endif %}{{ enc.opponent_city }}</span>
              {% endif %}
              <input type="hidden" name="opponent_team_ids[]" value="{{ enc.opponent_team_id }}">
            </div>
            <div class="flex items-center gap-3">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-slate-600">USM</span>
                <input type="number" name="scores[{{ enc.opponent_team_id }}][sets_for]" min="0" max="5"
                       value="{{ enc.sets_for ?? '' }}" placeholder="Ex: 3"
                       class="w-16 text-center border border-slate-200 bg-white rounded-lg px-2 py-1.5 text-sm font-bold">
              </div>
              <span class="text-slate-400 font-bold">-</span>
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-slate-600">Adv</span>
                <input type="number" name="scores[{{ enc.opponent_team_id }}][sets_against]" min="0" max="5"
                       value="{{ enc.sets_against ?? '' }}" placeholder="Ex: 1"
                       class="w-16 text-center border border-slate-200 bg-white rounded-lg px-2 py-1.5 text-sm font-bold">
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="grid sm:grid-cols-2 gap-6">
        {# Adversaire #}
        <div class="sm:col-span-2">
          <label class="block text-sm font-bold text-slate-700 mb-1.5" for="opponent_team_id">Équipe adverse</label>
          <select id="opponent_team_id" name="opponent_team_id"
                  class="w-full border border-slate-200 bg-white rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#94674d]/20 focus:border-[#94674d] transition">
            <option value="">-- Aucun adversaire (Entraînement / Autre) --</option>
            {% for op in opponent_teams %}
              <option value="{{ op.id }}" {{ (match_result.opponent_team_id ?? '') == op.id ? 'selected' : '' }}>
                {{ op.name }}{% if op.club %} ({{ op.club }}){% endif %}{% if op.city %} - {{ op.city }}{% endif %}
              </option>
            {% endfor %}
          </select>
          <p class="text-xs text-slate-400 mt-1">Gérez le référentiel des clubs et équipes dans <a href="{{ url('admin/opponent-teams') }}" class="text-[#94674d] font-bold underline" target="_blank">Équipes adverses</a>.</p>
        </div>

        {# Sets Pour (USM) #}
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1.5" for="sets_for">Sets USM</label>
          <input type="number" id="sets_for" name="sets_for" min="0" max="5"
                 value="{{ match_result.sets_for ?? '' }}" placeholder="Ex: 3"
                 class="w-full border border-slate-200 bg-white rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#94674d]/20 focus:border-[#94674d] transition">
        </div>

        {# Sets Contre (Adversaire) #}
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1.5" for="sets_against">Sets Adversaire</label>
          <input type="number" id="sets_against" name="sets_against" min="0" max="5"
                 value="{{ match_result.sets_against ?? '' }}" placeholder="Ex: 1"
                 class="w-full border border-slate-200 bg-white rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#94674d]/20 focus:border-[#94674d] transition">
        </div>
      </div>
    {% endif %}
  </div>

  <div class="flex items-center gap-3 pt-2">
    {{ m.btn_submit(manifestation ? 'Mettre à jour' : 'Créer la manifestation') }}
    <a href="{{ url('admin/manifestations') }}"
       class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-slate-700 transition">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      Annuler
    </a>
  </div>
</form>
{% endblock %}
