{% extends 'emails/_layout.twig' %}

{% block title %}{% if IS_MATCH %}Nouveau match{% else %}Nouvel événement{% endif %} - USM Volley{% endblock %}

{% block header_title %}{% if IS_MATCH %}🏆 Nouveau match publié{% else %}📅 Nouvel événement publié{% endif %}{% endblock %}
{% block header_subtitle %}USM Volley — Agenda collectif{% endblock %}

{% block content %}
    <div class="greeting">Bonjour {{ PLAYER_NAME }},</div>
    <div class="intro">
        {% if IS_MATCH %}
            Un nouveau match concernant l'équipe <strong>{{ TEAM_NAME }}</strong> vient d'être publié :
        {% else %}
            Un nouvel entraînement ou événement vient d'être publié :
        {% endif %}
    </div>

    <div class="info-box">
        <div class="field-label">🏆 Intitulé</div>
        <div class="field-value title">{{ EVENT_TITLE }}</div>

        <div class="field-label">📅 Date et Heure</div>
        <div class="field-value">{{ EVENT_DATE }}</div>

        <div class="field-label">📍 Lieu</div>
        <div class="field-value">{{ EVENT_LOCATION }}</div>

        {{ COMMENT_HTML|raw }}
    </div>

    <p style="font-size: 14px; color: #475569; margin-bottom: 16px;">Veuillez indiquer dès à présent votre disponibilité :</p>
    
    {{ BUTTONS_HTML|raw }}
    
    <div class="cta-wrapper">
        <a href="{{ DASHBOARD_URL }}" class="cta-button">Accéder à mon espace →</a>
    </div>
{% endblock %}

{% block footer %}
    © USM Volley — Ne pas répondre directement à cet email.
{% endblock %}
