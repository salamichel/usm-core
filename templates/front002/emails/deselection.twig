{% extends 'emails/_layout.twig' %}

{% block title %}Annulation de convocation - USM Volley{% endblock %}

{% block header_bg_color %}#c2410c{% endblock %}
{% block header_sub_color %}#ffedd5{% endblock %}

{% block header_title %}❌ Annulation de convocation{% endblock %}
{% block header_subtitle %}USM Volley — Notification d'équipe{% endblock %}

{% block content %}
    <div class="greeting">Bonjour {{ playerName }},</div>
    <div class="intro">Votre convocation a été annulée. Vous n'êtes plus sélectionné(e) pour le match suivant :</div>

    <div class="info-box warning">
        <div class="field-label">🏆 Rencontre</div>
        <div class="field-value title">{{ eventTitle }}</div>

        <div class="field-label">📅 Date et Heure</div>
        <div class="field-value">{{ eventDate }}</div>

        <div class="field-label">📍 Lieu</div>
        <div class="field-value">{{ eventLocation }}</div>
    </div>

    <p style="font-size: 14px; color: #475569;">Veuillez prendre en compte ce changement dans votre planning. N'hésitez pas à vous connecter pour consulter les autres événements à venir.</p>
    
    <div class="cta-wrapper">
        <a href="{{ dashboardUrl }}" class="cta-button dark">Accéder à mon espace →</a>
    </div>
{% endblock %}

{% block footer %}
    © USM Volley — Ne pas répondre directement à cet email.
{% endblock %}
