<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}USM Volley{% endblock %}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f8fafc; color: #334155; line-height: 1.6; }
        .container { max-width: 600px; margin: 30px auto; padding: 0 16px; }
        .card { background-color: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.05); }
        .header { background-color: {% block header_bg % release %}{% endblock %}; color: #ffffff; padding: 28px 32px; text-align: center; }
        .header h1 { font-size: 22px; font-weight: 700; color: #ffffff; letter-spacing: -0.5px; margin-bottom: 4px; }
        .header p { font-size: 13px; color: {% block header_sub_color %}#94a3b8{% endblock %}; font-weight: 500; }
        .content { padding: 32px; }
        .greeting { font-size: 16px; font-weight: 600; color: #0f172a; margin-bottom: 8px; }
        .intro { font-size: 14px; color: #475569; margin-bottom: 20px; }
        .info-box { background-color: #f8fafc; padding: 20px; border-radius: 12px; border-left: 4px solid #0284c7; border-top: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; margin-bottom: 20px; }
        .info-box.danger { background-color: #fef2f2; border-left-color: #ef4444; border-color: #fee2e2; }
        .info-box.warning { background-color: #fff7ed; border-left-color: #ea580c; border-color: #ffedd5; }
        .info-box.success { background-color: #f0fdf4; border-left-color: #10b981; border-color: #dcfce7; }
        .box-title { font-weight: 700; text-transform: uppercase; font-size: 12px; margin-bottom: 8px; }
        .box-title.danger { color: #dc2626; }
        .box-title.warning { color: #9a3412; }
        .box-title.success { color: #16a34a; }
        .field-label { font-weight: 600; text-transform: uppercase; font-size: 11px; color: #64748b; letter-spacing: 0.5px; margin-top: 10px; margin-bottom: 2px; }
        .field-label:first-child { margin-top: 0; }
        .field-value { font-size: 15px; color: #0f172a; font-weight: 600; }
        .field-value.title { font-size: 17px; font-weight: 700; color: #0f172a; }
        .field-value.name { font-size: 17px; font-weight: 700; color: #0f172a; }
        .field-value.password { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 16px; color: #0284c7; background-color: #ffffff; border: 1px solid #bae6fd; padding: 6px 12px; border-radius: 6px; display: inline-block; margin-top: 4px; }
        .field-value a { color: #0284c7; text-decoration: none; }
        .old-value { color: #ef4444; text-decoration: line-through; font-size: 13px; margin-left: 8px; }
        .credentials-box { background-color: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: 16px; }
        .account-badge { display: inline-block; background-color: #e0f2fe; color: #0369a1; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 20px; margin-bottom: 12px; }
        .message-box { background-color: #f1f5f9; padding: 18px; border-radius: 12px; border-left: 4px solid #0284c7; margin: 16px 0; line-height: 1.6; white-space: pre-wrap; word-wrap: break-word; color: #1e293b; font-size: 14.5px; }
        .sender-box { background-color: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: 20px; }
        .subject-title { font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 12px; }
        .tip { font-size: 13px; color: #64748b; background-color: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid #e2e8f0; margin-top: 20px; }
        .cta-wrapper { text-align: center; margin-top: 24px; margin-bottom: 12px; }
        .cta-button { display: inline-block; background-color: #0284c7; color: #ffffff; padding: 12px 28px; border-radius: 10px; font-weight: 700; font-size: 14px; text-decoration: none; box-shadow: 0 2px 4px rgba(2, 132, 199, 0.25); }
        .cta-button.dark { background-color: #0f172a; box-shadow: 0 2px 4px rgba(15, 23, 42, 0.2); }
        .event-card { background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; margin-bottom: 16px; }
        .event-title { font-size: 16px; font-weight: 700; color: #0f172a; margin-bottom: 6px; }
        .event-meta { font-size: 13.5px; color: #64748b; margin-bottom: 10px; line-height: 1.5; }
        .status-badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; color: #ffffff; margin-bottom: 8px; }
        .notice { margin-top: 24px; font-size: 12px; color: #94a3b8; text-align: center; line-height: 1.5; }
        .footer { text-align: center; font-size: 12px; color: #94a3b8; margin-top: 24px; padding: 12px 0; }
        .footer a { color: #0284c7; text-decoration: underline; font-weight: 600; }
        {% block extra_css %}{% endblock %}
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="header" style="background-color: {% block header_bg_color %}#0f172a{% endblock %};">
                <h1>{% block header_title %}USM Volley{% endblock %}</h1>
                <p>{% block header_subtitle %}Espace Adhérent{% endblock %}</p>
            </div>

            <div class="content">
                {% block content %}{% endblock %}
            </div>
        </div>

        <div class="footer">
            {% block footer %}
                © USM Volley — Cet e-mail est envoyé automatiquement, merci de ne pas y répondre directement.
            {% endblock %}
        </div>
    </div>
</body>
</html>
