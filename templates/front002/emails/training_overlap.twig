{% extends 'emails/_layout.twig' %}

{% block title %}Chevauchement d'agenda - USM Volley{% endblock %}

{% block header_bg_color %}#c2410c{% endblock %}
{% block header_sub_color %}#ffedd5{% endblock %}

{% block header_title %}⚠️ Chevauchement d'agenda{% endblock %}
{% block header_subtitle %}USM Volley — Ajustement automatique{% endblock %}

{% block content %}
    <div class="greeting">Bonjour {{ playerName }},</div>
    <div class="intro">Vous avez été sélectionné(e) pour un match. En conséquence, votre présence a été retirée de l'entraînement suivant qui se déroule au même moment :</div>

    <div class="info-box danger">
        <div class="box-title danger">❌ Entraînement annulé (retrait)</div>
        <div class="field-label">🏃 Séance</div>
        <div class="field-value">{{ trainingTitle }}</div>
        <div class="field-label">📅 Date et Heure</div>
        <div class="field-value">{{ trainingDate }}</div>
        <div class="field-label">📍 Lieu</div>
        <div class="field-value">{{ trainingLocation }}</div>
    </div>

    <p style="font-size: 14px; color: #475569; margin-top: 16px; margin-bottom: 12px;">Voici le match pour lequel vous êtes sélectionné(e) :</p>

    <div class="info-box success">
        <div class="box-title success">✅ Match prioritaire</div>
        <div class="field-label">🏆 Rencontre</div>
        <div class="field-value">{{ matchTitle }}</div>
        <div class="field-label">📅 Date et Heure</div>
        <div class="field-value">{{ matchDate }}</div>
        <div class="field-label">📍 Lieu</div>
        <div class="field-value">{{ matchLocation }}</div>
    </div>

    <p style="font-size: 14px; color: #475569; margin-top: 16px;">Votre capitaine a été informé de ce retrait. Vous pouvez consulter les détails sur votre espace adhérent.</p>
    
    <div class="cta-wrapper">
        <a href="{{ dashboardUrl }}" class="cta-button dark">Accéder à mon espace →</a>
    </div>
{% endblock %}

{% block footer %}
    © USM Volley — Cet email a été envoyé en copie à votre capitaine.
{% endblock %}
