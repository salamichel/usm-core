{% extends 'emails/_layout.twig' %}

{% block title %}Modification de match - USM Volley{% endblock %}

{% block header_bg_color %}#c2410c{% endblock %}
{% block header_sub_color %}#ffedd5{% endblock %}

{% block header_title %}⚠️ Modification de match{% endblock %}
{% block header_subtitle %}USM Volley — Notification de changement{% endblock %}

{% block content %}
    <div class="greeting">Bonjour {{ PLAYER_NAME }},</div>
    <div class="intro">Les détails d'une rencontre pour laquelle vous êtes sélectionné(e) ont été modifiés par votre capitaine :</div>

    <div class="info-box warning">
        <div style="font-weight: 700; color: #9a3412; font-size: 16px; margin-bottom: 12px;">🏆 Match : {{ EVENT_TITLE }}</div>
        
        <div class="field-label">📅 Nouvelle Date / Heure</div>
        <div class="field-value">
            {{ NEW_DATE }}
            {% if OLD_DATE and OLD_DATE != NEW_DATE %}
                <span class="old-value">({{ OLD_DATE }})</span>
            {% endif %}
        </div>

        <div class="field-label">📍 Nouveau Lieu</div>
        <div class="field-value">
            {{ NEW_LOCATION }}
            {% if OLD_LOCATION and OLD_LOCATION != NEW_LOCATION %}
                <span class="old-value">({{ OLD_LOCATION }})</span>
            {% endif %}
        </div>
    </div>

    <p style="font-size: 14px; color: #475569;">Veuillez prendre en compte ces modifications dans votre planning. Merci de vous connecter à votre espace adhérent pour confirmer vos disponibilités.</p>
    
    <div class="cta-wrapper">
        <a href="{{ DASHBOARD_URL }}" class="cta-button dark">Accéder à mon espace →</a>
    </div>
{% endblock %}

{% block footer %}
    © USM Volley — Ne pas répondre directement à cet email.
{% endblock %}
