{% extends 'emails/_layout.twig' %}

{% block title %}Convocation match - USM Volley{% endblock %}

{% block header_title %}🏐 Convocation match{% endblock %}
{% block header_subtitle %}USM Volley — Sélection d'équipe{% endblock %}

{% block content %}
    <div class="greeting">Bonjour {{ PLAYER_NAME }},</div>
    <div class="intro">Vous avez été sélectionné(e) pour participer au match suivant :</div>

    <div class="info-box success">
        <div class="field-label">🏆 Rencontre</div>
        <div class="field-value title">{{ EVENT_TITLE }}</div>

        <div class="field-label">📅 Date et Heure</div>
        <div class="field-value">{{ EVENT_DATE }}</div>

        <div class="field-label">📍 Lieu</div>
        <div class="field-value">{{ EVENT_LOCATION }}</div>
        
        {{ COMMENT_HTML|raw }}
    </div>

    <p style="font-size: 14px; color: #475569;">Merci de vous connecter à votre espace adhérent pour confirmer vos informations ou consulter l'agenda complet.</p>
    
    <div class="cta-wrapper">
        <a href="{{ DASHBOARD_URL }}" class="cta-button">Accéder à mon espace →</a>
    </div>
{% endblock %}

{% block footer %}
    © USM Volley — Ne pas répondre directement à cet email.
{% endblock %}
