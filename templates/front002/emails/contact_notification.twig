{% extends 'emails/_layout.twig' %}

{% block title %}Nouveau message de contact - USM Volley{% endblock %}

{% block header_title %}📬 Nouveau message de contact{% endblock %}
{% block header_subtitle %}Formulaire du site web{% endblock %}

{% block content %}
    <div class="sender-box">
        <div class="field-label">💬 Message de</div>
        <div class="field-value">{{ SENDER_NAME }}</div>
        
        <div class="field-label">📧 Email</div>
        <div class="field-value"><a href="mailto:{{ SENDER_EMAIL }}">{{ SENDER_EMAIL }}</a></div>
        
        <div class="field-label">📱 Téléphone</div>
        <div class="field-value"><a href="tel:{{ SENDER_PHONE }}">{{ SENDER_PHONE }}</a></div>
    </div>

    <div class="field-label">🏷️ Sujet</div>
    <div class="subject-title">{{ SUBJECT }}</div>

    <div class="field-label">💭 Message</div>
    <div class="message-box">{{ MESSAGE|raw }}</div>

    <div class="cta-wrapper">
        <a href="{{ REPLY_URL }}" class="cta-button">Lire et répondre sur l'admin →</a>
    </div>
{% endblock %}

{% block footer %}
    © USM Volley — Ne pas répondre directement à cet email.
{% endblock %}
