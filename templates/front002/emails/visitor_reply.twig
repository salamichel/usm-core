{% extends 'emails/_layout.twig' %}

{% block title %}Réponse à votre message - {{ CLUB_NAME }}{% endblock %}

{% block header_title %}✉️ Réponse à votre message{% endblock %}
{% block header_subtitle %}{{ CLUB_NAME }}{% endblock %}

{% block content %}
    <div class="greeting">Bonjour {{ VISITOR_NAME }},</div>
    <div class="intro">Merci de nous avoir contactés. Voici notre réponse à votre message :</div>

    <div class="message-box">{{ REPLY_TEXT|raw }}</div>

    <p style="font-size: 14px; color: #475569;">Si vous avez d'autres questions, n'hésitez pas à nous recontacter.</p>

    <div style="background-color: #f8fafc; padding: 18px; border-radius: 12px; border: 1px solid #e2e8f0; margin-top: 24px; font-size: 13px; color: #475569;">
        {{ SIGNATURE_HTML|raw }}
        {{ CONTACT_INFO|raw }}
    </div>
{% endblock %}

{% block footer %}
    © {{ CLUB_NAME }}
{% endblock %}
