{% extends 'emails/_layout.twig' %}

{% block title %}Vos identifiants - USM Volley{% endblock %}

{% block header_title %}🔑 Vos identifiants de connexion{% endblock %}
{% block header_subtitle %}USM Volley — Espace Adhérent{% endblock %}

{% block content %}
    {% if ACCOUNTS is defined and ACCOUNTS|length > 1 %}
        <div class="greeting">Bonjour,</div>
        <div class="intro">Vous avez demandé la récupération de vos identifiants pour accéder à l'espace adhérent USM Volley.</div>
        
        <div class="info-box">
            Plusieurs comptes (<strong>{{ ACCOUNTS|length }}</strong>) sont associés à l'adresse <strong>{{ EMAIL }}</strong> :
        </div>

        {% for account in ACCOUNTS %}
            <div class="credentials-box">
                <div class="account-badge">👤 Compte {{ loop.index }} sur {{ loop.length }}</div>
                
                <div class="field-label">Adhérent</div>
                <div class="field-value name">{{ account.name }}</div>

                <div class="field-label">Adresse email</div>
                <div class="field-value">{{ account.email }}</div>
                
                <div class="field-label">Mot de passe</div>
                <div>
                    <span class="field-value password">{{ account.password }}</span>
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="greeting">Bonjour {{ PLAYER_NAME }},</div>
        <div class="intro">Vous avez demandé la récupération de vos identifiants pour accéder à l'espace adhérent USM Volley.</div>
        
        <div class="info-box">
            Voici vos identifiants de connexion actuels :
        </div>

        <div class="credentials-box">
            <div class="field-label">Adresse email</div>
            <div class="field-value">{{ EMAIL }}</div>
            
            <div class="field-label">Mot de passe</div>
            <div>
                <span class="field-value password">{{ PASSWORD }}</span>
            </div>
        </div>
    {% endif %}

    <div class="cta-wrapper">
        <a href="{{ LOGIN_URL }}" class="cta-button">Se connecter à l'espace adhérent →</a>
    </div>

    <div class="notice">
        Si vous n'êtes pas à l'origine de cette demande, vous pouvez ignorer cet e-mail en toute sécurité.
    </div>
{% endblock %}
