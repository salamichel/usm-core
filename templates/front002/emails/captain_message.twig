{% extends 'emails/_layout.twig' %}

{% block title %}Message Capitaine - USM Volley{% endblock %}

{% block header_title %}🏐 Message Capitaine{% endblock %}
{% block header_subtitle %}Équipe {{ TEAM_NAME }}{% endblock %}

{% block content %}
    <div class="greeting">Bonjour {{ CAPTAIN_NAME }},</div>
    <div class="intro">Vous avez reçu un nouveau message depuis le site web en tant que capitaine de l'équipe <strong>{{ TEAM_NAME }}</strong>.</div>

    <div class="sender-box">
        <div class="field-label">💬 Expéditeur</div>
        <div class="field-value">{{ SENDER_NAME }}</div>
        
        <div class="field-label">📧 Email de contact</div>
        <div class="field-value"><a href="mailto:{{ SENDER_EMAIL }}">{{ SENDER_EMAIL }}</a></div>
    </div>

    <div class="field-label">🏷️ Sujet</div>
    <div class="subject-title">{{ SUBJECT }}</div>

    <div class="field-label">💭 Message</div>
    <div class="message-box">{{ MESSAGE|raw }}</div>

    <div class="tip">
        💡 <strong>Conseil :</strong> Vous pouvez répondre directement à ce message en écrivant à l'adresse de contact ci-dessus.
    </div>
{% endblock %}

{% block footer %}
    © USM Volley — Votre adresse email n'a pas été divulguée à l'expéditeur.
{% endblock %}
