{% extends 'emails/_layout.twig' %}

{% block title %}{{ EVENT_TYPE_UPPER|default('MATCH') }} Annulé - USM Volley{% endblock %}

{% block header_bg_color %}#991b1b{% endblock %}
{% block header_sub_color %}#fecaca{% endblock %}

{% block header_title %}❌ {{ EVENT_TYPE_UPPER|default('MATCH') }} ANNULÉ{% endblock %}
{% block header_subtitle %}USM Volley — Notification d'annulation{% endblock %}

{% block content %}
    <div class="greeting">Bonjour {{ PLAYER_NAME }},</div>
    <div class="intro" style="color: #dc2626; font-weight: 600;">{{ CANCELLATION_TEXT|default('Le match suivant pour lequel vous étiez sélectionné(e) a été annulé :')|raw }}</div>

    <div class="info-box danger">
        <div class="field-label">🏆 Rencontre</div>
        <div class="field-value title" style="color: #7f1d1d;">{{ EVENT_TITLE }}</div>

        <div class="field-label">📅 Date et Heure initiales</div>
        <div class="field-value">{{ EVENT_DATE }}</div>

        <div class="field-label">📍 Lieu</div>
        <div class="field-value">{{ EVENT_LOCATION }}</div>
    </div>

    <p style="font-size: 14px; color: #475569;">Veuillez prendre en compte cette annulation dans votre agenda. Vous pouvez consulter les autres événements à venir sur votre espace adhérent.</p>
    
    <div class="cta-wrapper">
        <a href="{{ DASHBOARD_URL }}" class="cta-button dark">Accéder à mon espace →</a>
    </div>
{% endblock %}

{% block footer %}
    © USM Volley — Ne pas répondre directement à cet email.
{% endblock %}
