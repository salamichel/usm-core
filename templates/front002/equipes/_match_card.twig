{# Carte de rencontre d'équipe cliquable (thème front002) #}
{% set isDomicile = event.lieu and ('salles' in event.lieu|lower or 'mios' in event.lieu|lower) %}
{% set isCancelled = event.statut == 'Annulé' or event.annule %}
{% set isReported = event.statut == 'Reporté' %}
{% set isProvisoire = event.statut == 'Provisoire' or event.provisoire %}

<a href="{{ url('agenda/' ~ event.id) }}"
   class="group block bg-white rounded-3xl p-5 border border-slate-100 shadow-sm hover:-translate-y-1 hover:shadow-md hover:border-[var(--primary)]/30 focus:outline-none focus:ring-2 focus:ring-[var(--primary)]/20 transition-all duration-200 relative overflow-hidden">
  
  {# En-tête : Badge Lieu (Domicile/Extérieur) et Badge Statut #}
  <div class="flex items-start justify-between gap-3 mb-3">
    <div>
      {% if isDomicile %}
        <span class="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-xl border border-emerald-100">
          <span>🏠</span> Domicile
        </span>
      {% elseif event.lieu %}
        <span class="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-sky-700 bg-sky-50 px-2.5 py-1 rounded-xl border border-sky-100">
          <span>✈️</span> Extérieur
        </span>
      {% else %}
        <span class="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-slate-600 bg-slate-50 px-2.5 py-1 rounded-xl border border-slate-200">
          Match
        </span>
      {% endif %}
    </div>

    <div>
      {% if isCancelled %}
        <span class="inline-flex items-center gap-1 text-[11px] font-bold text-rose-700 bg-rose-50 px-2.5 py-1 rounded-xl border border-rose-200">
          ✕ Annulé
        </span>
      {% elseif isReported %}
        <span class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-xl border border-amber-200">
          ⏱ Reporté
        </span>
      {% elseif isProvisoire %}
        <span class="inline-flex items-center gap-1 text-[11px] font-bold text-purple-700 bg-purple-50 px-2.5 py-1 rounded-xl border border-purple-200">
          ⚡ Provisoire
        </span>
      {% elseif event.is_past %}
        <span class="inline-flex items-center gap-1 text-[11px] font-bold text-slate-600 bg-slate-100 px-2.5 py-1 rounded-xl border border-slate-200">
          ✓ Terminé
        </span>
      {% else %}
        <span class="inline-flex items-center gap-1 text-[11px] font-bold text-[var(--primary)] bg-[var(--primary)]/10 px-2.5 py-1 rounded-xl border border-[var(--primary)]/20">
          À venir
        </span>
      {% endif %}
    </div>
  </div>

  {# Titre de la rencontre #}
  <div class="mb-3 space-y-1">
    <h3 class="font-serif font-bold text-base text-slate-900 group-hover:text-[var(--primary)] transition-colors leading-snug line-clamp-2">
      {{ event.titre }}{% if event.opponent_name %} <span class="text-amber-800 font-extrabold block text-sm">{% if event.is_plateau %}Plateau vs {{ event.opponent_name }}{% else %}vs {{ event.opponent_name }}{% endif %}</span>{% endif %}
    </h3>
    {% if event.has_score %}
      <div class="pt-1 flex flex-wrap items-center gap-1.5">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-black {{ event.outcome_badge_classes|default('bg-slate-100 text-slate-800') }}">
          🏆 {% if event.is_plateau %}Bilan : {{ event.score_formatted }}{% else %}{{ event.outcome_label|default('Résultat') }} : {{ event.score_formatted }}{% endif %}
        </span>
        {% if event.is_plateau and event.encounters is defined %}
          {% for enc in event.encounters %}
            {% if enc.has_score %}
              <span class="text-[10px] text-slate-600 font-bold bg-slate-100 px-2 py-0.5 rounded-md">
                vs {{ enc.opponent_name }} ({{ enc.score_formatted }})
              </span>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    {% endif %}
  </div>

  {# Informations d'organisation #}
  <div class="space-y-1.5 text-xs text-slate-500 mb-4">
    <p class="flex items-center gap-2 font-semibold text-slate-700">
      <span class="text-slate-400">📅</span>
      <span>{{ event.date_display }}</span>
    </p>
    {% if event.time_range %}
      <p class="flex items-center gap-2">
        <span class="text-slate-400">🕐</span>
        <span>{{ event.time_range }}</span>
      </p>
    {% endif %}
    {% if event.lieu %}
      <p class="flex items-center gap-2 truncate" title="{{ event.lieu }}">
        <span class="text-slate-400">📍</span>
        <span class="truncate">{{ event.lieu }}</span>
      </p>
    {% endif %}
  </div>

  {% if event.commentaire %}
    <p class="text-[11px] text-slate-500 italic bg-slate-50 rounded-xl p-2.5 border border-slate-100 mb-4 line-clamp-2">
      {{ event.commentaire }}
    </p>
  {% endif %}

  {# Pied de carte : Indicateurs d'effectif et Lien interactif #}
  <div class="border-t border-slate-100 pt-3 flex items-center justify-between gap-2">
    <div>
      {% if event.is_past %}
        {% if event.nb_present > 0 %}
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700">
            <span class="w-2 h-2 rounded-full bg-slate-400"></span>
            <span>{{ event.nb_present }} joueur{{ event.nb_present > 1 ? 's' : '' }} sur la feuille</span>
          </span>
        {% else %}
          <span class="text-xs text-slate-400 italic">Feuille de match</span>
        {% endif %}
      {% else %}
        {% if event.nb_present >= event.min_players %}
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-lg border border-emerald-100">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Prêt ({{ event.nb_present }}/{{ event.min_players }})</span>
          </span>
        {% elseif event.nb_present > 0 %}
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-100">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span>{{ event.nb_present }}/{{ event.min_players }} sélectionné{{ event.nb_present > 1 ? 's' : '' }}</span>
          </span>
        {% else %}
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-600 bg-slate-50 px-2 py-0.5 rounded-lg border border-slate-200">
            <span>👥 {{ event.nb_disponible }} dispo{{ event.nb_disponible > 1 ? 's' : '' }}</span>
          </span>
        {% endif %}
      {% endif %}
    </div>

    <span class="inline-flex items-center gap-1 text-xs font-bold text-slate-400 group-hover:text-[var(--primary)] transition-colors">
      <span>Détails</span>
      <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </span>
  </div>
</a>
