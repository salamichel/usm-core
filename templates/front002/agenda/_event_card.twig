{# 
  Partial for an event card.
  Parameters:
    - m: The manifestation object
    - allow_actions: (bool) Whether to show participation action buttons
    - show_link: (bool) Whether to make the card or title link to the detail page
    - is_first: (bool) Whether this is the first card in the list
#}

{# Détermination du style de fond de la carte #}
{% set is_selected = m.user_status_category is defined and m.user_status_category == 'selected' and not m.annule %}
{% set is_overlapping_selected = m.is_overlapping_selected|default(false) and not m.annule %}

{% if m.annule %}
    {% set is_active_bg = 'bg-rose-50/20 border-rose-200/80 opacity-80 shadow-sm' %}
{% elseif m.provisoire %}
    {% set is_active_bg = 'bg-amber-50/20 border-amber-300 shadow-sm' %}
{% elseif is_selected %}
    {% set is_active_bg = 'bg-amber-50/30 border-amber-400 ring-4 ring-amber-400/30 shadow-md shadow-amber-200/50' %}
{% elseif is_overlapping_selected %}
    {% set is_active_bg = 'bg-slate-50/60 border-slate-200 opacity-90 shadow-sm' %}
{% elseif is_first %}
    {% set is_active_bg = 'bg-indigo-50/20 border-indigo-200/80 shadow-sm' %}
{% else %}
    {% set is_active_bg = 'bg-white border-slate-200/80 shadow-sm hover:border-indigo-300 hover:shadow-md' %}
{% endif %}

<div class="group rounded-[28px] border transition-all duration-300 flex flex-col relative overflow-hidden cursor-pointer {{ is_active_bg }}" 
     data-manifestation-id="{{ m.id }}" 
     data-event-url="{{ url('agenda/' ~ m.id) }}"
     data-event-date="{{ m.date|slice(0, 10) }}"
     data-event-filter="{% if 'forum' in m.titre|lower or 'forum' in m.type|lower %}forum{% elseif m.is_match %}match{% else %}{{ m.type|lower|replace({' ': '-'}) }}{% endif %}"
     data-current-status="{{ m.user_status|default('.') }}"
     data-event-location="{{ m.lieu|default('') }}"
     data-min-players="{{ m.min_players|default(6) }}"
     data-event-type-raw="{{ m.type|default('') }}"
     data-event-subtype-raw="{{ m.titre|default('') }}"
     data-event-location-raw="{{ m.lieu|default('') }}"
     data-event-kind-raw="{% if 'Présences' in m.ManifestationTypée %}Présences{% else %}Disponibilités{% endif %}">

    {# Statut Badges Flottants #}
    {% if m.annule %}
        <div class="absolute -top-1 -right-1 z-30">
            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-bl-2xl rounded-tr-2xl text-[10px] font-black uppercase tracking-wider bg-rose-600 text-white shadow-md">
                ✗ Annulé
            </span>
        </div>
    {% elseif m.provisoire %}
        <div class="absolute -top-1 -right-1 z-30">
            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-bl-2xl rounded-tr-2xl text-[10px] font-black uppercase tracking-wider bg-amber-500 text-slate-900 shadow-md">
                ⚠ Provisoire
            </span>
        </div>
    {% elseif is_selected %}
        <div class="absolute -top-1 -right-1 z-30">
            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-bl-2xl rounded-tr-2xl text-[10px] font-black uppercase tracking-wider bg-gradient-to-r from-amber-500 to-yellow-500 text-white shadow-lg shadow-amber-500/20 animate-pulse">
                ★ Convoqué(e)
            </span>
        </div>
    {% elseif is_overlapping_selected %}
        <div class="absolute -top-1 -right-1 z-30">
            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-bl-2xl rounded-tr-2xl text-[10px] font-black uppercase tracking-wider bg-slate-200 text-slate-700 shadow-md">
                ⚠ Créneau concurrent
            </span>
        </div>
    {% endif %}
    
    {# --- ZONE CENTRALE : CONTENU DE LA CARTE --- #}
    <div class="p-5 sm:p-6 flex flex-col gap-4 flex-grow">
        <div class="flex flex-col md:flex-row md:items-start gap-4 sm:gap-5 w-full">
            
            {# --- 1. Date Badge Haute Visibilité (Jour de la semaine, Chiffre, Mois) --- #}
            {% set date_parts = m.date_display|split(' ') %}
            <div class="flex-shrink-0 flex items-center md:items-start gap-3.5">
                <div class="w-16 h-18 sm:w-18 sm:h-20 bg-slate-900 text-white rounded-2xl flex flex-col items-center justify-between p-2 shadow-md relative z-10 group-hover:scale-105 transition-transform duration-200">
                    <span class="text-[10px] font-black uppercase tracking-widest text-indigo-400 leading-none mt-0.5">
                        {{ date_parts[0]|default('') }}
                    </span>
                    <span class="text-2xl sm:text-3xl font-black leading-none text-white my-auto">
                        {{ date_parts[1]|default('') }}
                    </span>
                    <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-300 leading-none mb-0.5">
                        {{ date_parts[2]|default('')|slice(0, 3)|upper }}
                    </span>
                </div>

                {# Mobile uniquement : Rappel Type & Titre compact #}
                <div class="md:hidden flex-grow space-y-1">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-black tracking-wider uppercase bg-indigo-50 text-indigo-700 border border-indigo-100">
                            {{ m.type_simple|default(m.type|default('Événement')) }}
                        </span>
                    </div>
                    <h3 class="text-base sm:text-lg font-black text-slate-900 leading-snug group-hover:text-indigo-600 transition-colors">
                        {% if show_link %}
                            <a href="{{ url('agenda/' ~ m.id) }}" class="hover:underline">
                                {{ m.titre }}
                            </a>
                        {% else %}
                            {{ m.titre }}
                        {% endif %}
                    </h3>
                </div>
            </div>

            {# --- 2. Détails Événement (Titre Desktop, Badges Horaire & Lieu, Inscrits) --- #}
            <div class="flex-grow grid grid-cols-1 md:grid-cols-12 gap-4 items-start w-full">
                
                {# Bloc Titre, Type, Lieu & Horaire #}
                <div class="md:col-span-8 space-y-2.5">
                    {# Type et Titre Desktop #}
                    <div class="hidden md:block space-y-1">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-black tracking-wider uppercase bg-indigo-50 text-indigo-700 border border-indigo-100">
                            {{ m.type_simple|default(m.type|default('Événement')) }}
                        </span>
                        <h3 class="text-lg font-black text-slate-900 leading-snug group-hover:text-indigo-600 transition-colors">
                            {% if show_link %}
                                <a href="{{ url('agenda/' ~ m.id) }}" class="hover:underline">
                                    {{ m.titre }}
                                </a>
                            {% else %}
                                {{ m.titre }}
                            {% endif %}
                        </h3>
                    </div>

                    {# Badges Haute Visibilité : HORAIRE & LIEU #}
                    <div class="flex flex-wrap items-center gap-2 pt-1">
                        {# Badge HORAIRE #}
                        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-900 text-white font-bold text-xs shadow-sm border border-slate-800" title="Horaire de l'événement">
                            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span class="font-extrabold tracking-wide">{{ m.time_range|default('Horaire non précisé') }}</span>
                            {% if m.duration %}
                                <span class="text-slate-400 font-medium text-[11px]">({{ m.duration }})</span>
                            {% endif %}
                            {% if m.google_calendar_url %}
                                <a href="{{ m.google_calendar_url }}" target="_blank" rel="noopener noreferrer" class="ml-1 text-slate-400 hover:text-emerald-400 transition-colors p-0.5" title="Ajouter à Google Agenda">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                </a>
                            {% endif %}
                        </div>

                        {# Badge LIEU #}
                        {% if m.lieu %}
                            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50/90 text-indigo-950 font-bold text-xs shadow-sm border border-indigo-200/80" title="Lieu de l'événement">
                                <svg class="w-4 h-4 text-indigo-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                <span class="font-black text-indigo-900">{{ m.lieu }}</span>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Bloc Inscrits & Effectifs #}
                <div class="md:col-span-4 flex flex-row md:flex-col items-center md:items-end justify-between md:justify-start gap-2.5 w-full pt-2 md:pt-0 border-t border-slate-100 md:border-t-0">
                    {# Membres Avatars #}
                    <div class="flex flex-col items-start md:items-end">
                        <span class="text-[9px] font-black text-slate-400 tracking-wider uppercase">Inscrits</span>
                        <div class="flex items-center mt-1 avatar-stack">
                            {% if can_view_player_details %}
                                {% set list_players = m.is_match ? ((m.annule ? [] : m.selected)|merge(m.available)|merge(m.available_if_needed)) : m.present %}
                                {% set max_avatars = 5 %}
                                
                                {% for p in list_players|slice(0, max_avatars) %}
                                    {% set parts = p.nom|split(' ') %}
                                    {% set prenom = parts|last %}
                                    {% set initial = prenom|slice(0, 1)|upper %}
                                    {% set colors = [
                                        'bg-blue-100 text-blue-700',
                                        'bg-emerald-100 text-emerald-700',
                                        'bg-violet-100 text-violet-700',
                                        'bg-pink-100 text-pink-700',
                                        'bg-amber-100 text-amber-700',
                                        'bg-teal-100 text-teal-700'
                                    ] %}
                                    {% set color_class = colors[p.id % colors|length] %}
                                    <div class="w-7 h-7 rounded-full border-2 {% if p.is_waiting %}border-amber-400 ring-1 ring-amber-300{% else %}border-white{% endif %} {{ color_class }} flex items-center justify-center text-[9px] font-black -ml-2.5 first:ml-0 shadow-sm relative z-30" title="{{ p.is_waiting ? p.nom ~ ' (Attente +' ~ p.waiting_position ~ ')' : p.nom }}">
                                        {{ initial }}
                                    </div>
                                {% endfor %}
                                
                                {% set total_players = list_players|length %}
                                {% if total_players > max_avatars %}
                                    <div class="player-list-trigger cursor-pointer w-7 h-7 rounded-full border-2 border-white bg-slate-100 text-slate-700 flex items-center justify-center text-[9px] font-black -ml-2.5 relative z-30 shadow-sm hover:scale-110 hover:z-40 transition-all" 
                                         data-title="Joueurs inscrits" 
                                         data-players='{{ list_players|json_encode|e('html_attr') }}'>
                                        +{{ total_players - max_avatars }}
                                    </div>
                                {% elseif total_players > 0 %}
                                    <div class="player-list-trigger cursor-pointer w-7 h-7 rounded-full border-2 border-white bg-slate-50 text-slate-400 flex items-center justify-center text-[9px] font-bold -ml-2.5 relative z-30 shadow-sm hover:scale-110 hover:z-40 transition-all" 
                                         data-title="Joueurs inscrits" 
                                         data-players='{{ list_players|json_encode|e('html_attr') }}'>
                                        ℹ
                                    </div>
                                {% else %}
                                    <span class="text-[10px] text-slate-400 italic -ml-1">Aucun</span>
                                {% endif %}
                            {% else %}
                                <span class="text-[10px] text-slate-400 italic font-semibold">Masqué</span>
                            {% endif %}
                        </div>
                    </div>

                    {# Pastilles Effectifs #}
                    <div class="flex flex-col items-end md:w-full">
                        <div class="flex items-center gap-1.5 flex-wrap justify-end">
                            {% if m.is_match %}
                                {% if not m.annule %}
                                    <div class="{% if can_view_player_details %}player-list-trigger cursor-pointer hover:scale-105{% endif %} px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-amber-50 border border-amber-200 text-amber-800 transition-all flex items-center gap-0.5" 
                                         data-title="Joueurs convoqués" 
                                         data-status-key="selected"
                                         {% if can_view_player_details %}data-players='{{ m.selected|default([])|json_encode|e('html_attr') }}'{% endif %}>
                                        <span class="text-[9px]">★</span> <span class="count-value">{{ m.nb_selected|default(0) }}</span>
                                    </div>
                                {% endif %}
                                <div class="{% if can_view_player_details %}player-list-trigger cursor-pointer hover:scale-105{% endif %} px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-emerald-50 border border-emerald-100 text-emerald-700 transition-all flex items-center gap-0.5" 
                                     data-title="Joueurs disponibles" 
                                     data-status-key="available"
                                     {% if can_view_player_details %}data-players='{{ m.available|default([])|json_encode|e('html_attr') }}'{% endif %}>
                                    <span class="text-[9px]">✓</span> <span class="count-value">{{ m.nb_available|default(0) }}</span>
                                </div>
                                <div class="{% if can_view_player_details %}player-list-trigger cursor-pointer hover:scale-105{% endif %} px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-blue-50 border border-blue-150 text-blue-700 transition-all flex items-center gap-0.5" 
                                     data-title="Joueurs (Si besoin)" 
                                     data-status-key="available_if_needed"
                                     {% if can_view_player_details %}data-players='{{ m.available_if_needed|default([])|json_encode|e('html_attr') }}'{% endif %}>
                                     <span>◐</span> <span class="count-value">{{ m.nb_available_if_needed|default(0) }}</span>
                                </div>
                                <div class="{% if can_view_player_details %}player-list-trigger cursor-pointer hover:scale-105{% endif %} px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-rose-50 border border-rose-100 text-rose-600 transition-all flex items-center gap-0.5" 
                                     data-title="Joueurs indisponibles" 
                                     data-status-key="unavailable"
                                     {% if can_view_player_details %}data-players='{{ m.unavailable|default([])|json_encode|e('html_attr') }}'{% endif %}>
                                     <span>✗</span> <span class="count-value">{{ m.nb_unavailable|default(0) }}</span>
                                </div>
                            {% else %}
                                <div class="{% if can_view_player_details %}player-list-trigger cursor-pointer hover:scale-105{% endif %} px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-emerald-50 border border-emerald-100 text-emerald-700 transition-all flex items-center gap-0.5" 
                                     data-title="Joueurs présents" 
                                     data-status-key="present"
                                     {% if can_view_player_details %}data-players='{{ m.present|default([])|json_encode|e('html_attr') }}'{% endif %}>
                                    <span class="text-[9px]">✓</span> <span class="count-value">{{ m.nb_present_confirmed|default(m.nb_present|default(0)) }}</span>
                                </div>
                                {% if m.nb_waiting is defined and m.nb_waiting > 0 %}
                                    <div class="{% if can_view_player_details %}player-list-trigger cursor-pointer hover:scale-105{% endif %} px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-amber-100 border border-amber-300 text-amber-900 transition-all flex items-center gap-0.5 shadow-xs" 
                                         data-title="File d'attente (surnombre)" 
                                         data-status-key="waiting"
                                         {% if can_view_player_details %}data-players='{{ m.waiting_list|default([])|json_encode|e('html_attr') }}'{% endif %}
                                         title="En file d'attente : capacité du terrain atteinte ({{ m.capacity }} places max)">
                                        <span>⏳</span> <span class="count-value">+{{ m.nb_waiting }} attente</span>
                                    </div>
                                {% endif %}
                                <div class="{% if can_view_player_details %}player-list-trigger cursor-pointer hover:scale-105{% endif %} px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-rose-50 border border-rose-100 text-rose-600 transition-all flex items-center gap-0.5" 
                                     data-title="Joueurs absents" 
                                     data-status-key="absent"
                                     {% if can_view_player_details %}data-players='{{ m.absent|default([])|json_encode|e('html_attr') }}'{% endif %}>
                                    <span class="text-[9px]">✗</span> <span class="count-value">{{ m.nb_absent|default(0) }}</span>
                                </div>
                                <div class="{% if can_view_player_details %}player-list-trigger cursor-pointer hover:scale-105{% endif %} px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-slate-50 border border-slate-100 text-slate-600 transition-all flex items-center gap-0.5" 
                                     data-title="Joueurs incertains" 
                                     data-status-key="unknown"
                                     {% if can_view_player_details %}data-players='{{ m.unknown|default([])|json_encode|e('html_attr') }}'{% endif %}>
                                    <span class="text-[9px]">?</span> <span class="count-value">{{ m.nb_unknown|default(0) }}</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

            </div>
        </div>

        {# --- ALERTES & COMMENTAIRES --- #}
        {% if m.commentaire or (m.nb_terrains != 0 and m.nb_terrains != 1 and m.nb_terrains != '.') or (m.nb_waiting is defined and m.nb_waiting > 0) %}
            <div class="mt-1 pt-3 border-t border-slate-100 flex flex-wrap gap-2.5 w-full">
                {% if m.commentaire %}
                    <div class="text-xs text-slate-700 bg-indigo-50/50 rounded-xl p-2.5 border border-indigo-100 leading-relaxed flex-grow min-w-[200px] flex items-start gap-2 shadow-xs">
                        <svg class="w-4 h-4 text-indigo-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                        <span class="italic font-medium">{{ m.commentaire }}</span>
                    </div>
                {% endif %}

                {% if m.nb_waiting is defined and m.nb_waiting > 0 %}
                    <div class="flex items-center gap-1.5 text-xs font-bold text-amber-800 bg-amber-50 border border-amber-200 rounded-xl px-2.5 py-1.5 h-fit shrink-0">
                        <span>⏳</span> Surnombre : {{ m.nb_waiting }} en attente (capacité {{ m.capacity }} places)
                    </div>
                {% endif %}

                {% set terrain_alert = (m.nb_terrains != 0) and (m.nb_terrains != 1) and (m.nb_terrains != '.') %}
                {% if terrain_alert %}
                    <div class="flex items-center gap-1.5 text-xs font-bold text-rose-600 bg-rose-50 border border-rose-100 rounded-xl px-2.5 py-1.5 h-fit shrink-0">
                        <span>⚠</span> {{ m.nb_terrains }} terrains alloués
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {# --- 3. PIED DE CARTE DÉDIÉ : ACTIONS & STATUT (EN BAS SUR TOUS LES ÉCRANS) --- #}
    {% if allow_actions %}
        <div class="mt-auto border-t border-slate-150/80 bg-slate-50/90 p-4 sm:px-6 sm:py-3.5 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 z-20">
            {# Statut Actuel #}
            <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Votre statut :</span>
                <span id="status-{{ m.id }}" class="inline-flex items-center text-xs font-black {% if m.annule %}text-rose-600 line-through{% elseif m.user_status %}{% if m.user_status_category == 'selected' %}text-amber-600{% elseif m.user_status_category in ['available', 'present'] %}text-emerald-600{% elseif m.user_status_category == 'available_if_needed' %}text-amber-500{% elseif m.user_status_category in ['unavailable', 'absent'] %}text-rose-500{% elseif m.user_status_category == 'unknown' %}text-slate-600{% else %}text-slate-600{% endif %}{% else %}text-slate-400{% endif %}">
                    {% if m.annule %}
                        Annulé
                    {% elseif m.user_status %}
                        {% if m.user_status_category == 'selected' %} <span class="mr-1 text-xs">★</span> {{ m.user_status }}
                        {% elseif m.user_status_category in ['available', 'present'] %} <span class="mr-1 text-xs">✓</span> {{ m.user_status }}
                        {% elseif m.user_status_category == 'available_if_needed' %} <span class="mr-1 text-xs">◐</span> Si besoin
                        {% elseif m.user_status_category in ['unavailable', 'absent'] %} <span class="mr-1 text-xs">✗</span> {{ m.user_status }}
                        {% elseif m.user_status_category == 'unknown' %} <span class="mr-1 text-xs">?</span> {{ m.user_status }}
                        {% else %} {{ m.user_status }} {% endif %}
                    {% else %}
                        Non renseigné
                    {% endif %}
                </span>
            </div>

            {# Boutons d'Action / Sélecteur #}
            <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 w-full sm:w-auto">
                {% if m.annule %}
                    <div class="text-xs font-bold text-rose-800 bg-rose-50 border border-rose-200 rounded-xl px-3 py-2 w-full text-center flex items-center justify-center gap-1.5 shadow-xs">
                        ✗ Événement annulé
                    </div>
                {% elseif is_selected %}
                    <div class="text-xs font-extrabold text-amber-800 bg-amber-50 border border-amber-200 rounded-xl px-3 py-2 w-full text-center flex items-center justify-center gap-1.5 shadow-xs">
                        <span class="text-amber-500 text-sm">★</span> Convoqué(e) par le capitaine
                    </div>
                {% elseif is_overlapping_selected %}
                    <div class="text-xs font-extrabold text-rose-800 bg-rose-50 border border-rose-200 rounded-xl px-3 py-2 w-full text-center flex items-center justify-center gap-1.5 shadow-xs" title="Vous êtes déjà convoqué(e) sur un autre match à cet horaire.">
                        <span class="text-rose-500 text-sm">⚠</span> Créneau concurrent (Bloqué)
                    </div>
                {% else %}
                    {% if m.is_match %}
                        {% set is_dispo = m.user_status_category == 'available' %}
                        <button type="button" 
                                class="status-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-xl text-xs font-extrabold transition-all active:scale-95 flex items-center justify-center gap-1.5 shadow-sm {% if is_dispo %}bg-emerald-600 text-white shadow-emerald-200{% else %}bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200{% endif %}" 
                                data-status="Disponible"
                                title="Disponible">
                            <span class="text-xs">✓</span> Dispo
                        </button>

                        {% set is_sib = m.user_status_category == 'available_if_needed' %}
                        <button type="button" 
                                class="status-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-xl text-xs font-extrabold transition-all active:scale-95 flex items-center justify-center gap-1.5 shadow-sm {% if is_sib %}bg-amber-500 text-white shadow-amber-200{% else %}bg-amber-50 text-amber-700 hover:bg-amber-100 border border-amber-200{% endif %}" 
                                data-status="Disponible si nécessaire"
                                title="Si besoin">
                            <span class="text-xs">◐</span> Si besoin
                        </button>

                        {% set is_indispo = m.user_status_category == 'unavailable' %}
                        <button type="button" 
                                class="status-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-xl text-xs font-extrabold transition-all active:scale-95 flex items-center justify-center gap-1.5 shadow-sm {% if is_indispo %}bg-rose-600 text-white shadow-rose-200{% else %}bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200{% endif %}" 
                                data-status="Indisponible"
                                title="Indisponible">
                            <span class="text-xs">✗</span> Indispo
                        </button>
                    {% else %}
                        {% set is_present = m.user_status_category == 'present' %}
                        <select class="status-select flex-1 sm:flex-initial px-3 py-2 rounded-xl text-xs font-extrabold transition-all cursor-pointer focus:ring-2 focus:ring-[var(--primary)]/20 focus:outline-none border shadow-sm {% if is_present %}bg-emerald-600 text-white border-emerald-600{% else %}bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border-emerald-200{% endif %}">
                            <option class="text-slate-950 bg-white font-bold" value="" {% if not is_present %}selected{% endif %} disabled hidden>✓ Présent</option>
                            <option class="text-slate-950 bg-white font-bold" value="Présent(e)" {% if m.user_status == 'Présent(e)' %}selected{% endif %}>✓ Présent seul</option>
                            <option class="text-slate-950 bg-white font-bold" value="Présent(e) à 2" {% if m.user_status == 'Présent(e) à 2' %}selected{% endif %}>✓ Présent à 2</option>
                            <option class="text-slate-950 bg-white font-bold" value="Présent(e) à 3" {% if m.user_status == 'Présent(e) à 3' %}selected{% endif %}>✓ Présent à 3</option>
                            <option class="text-slate-950 bg-white font-bold" value="Présent(e) à 4" {% if m.user_status == 'Présent(e) à 4' %}selected{% endif %}>✓ Présent à 4</option>
                            <option class="text-slate-950 bg-white font-bold" value="Présent(e) à 5" {% if m.user_status == 'Présent(e) à 5' %}selected{% endif %}>✓ Présent à 5</option>
                        </select>

                        <button type="button" 
                                class="status-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-xl text-xs font-extrabold transition-all active:scale-95 flex items-center justify-center gap-1.5 shadow-sm {% if m.user_status == 'Absent(e)' %}bg-rose-600 text-white shadow-rose-200{% else %}bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200{% endif %}" 
                                data-status="Absent(e)"
                                title="Absent">
                            <span class="text-xs">✗</span> Absent
                        </button>

                        <button type="button" 
                                class="status-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-xl text-xs font-extrabold transition-all active:scale-95 flex items-center justify-center gap-1.5 shadow-sm {% if m.user_status == 'Ne sait pas' %}bg-slate-600 text-white{% else %}bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200{% endif %}" 
                                data-status="Ne sait pas"
                                title="Incertain">
                            <span class="text-xs">?</span> Ne sait pas
                        </button>
                    {% endif %}
                    
                    {% set is_reset = not m.user_status or m.user_status == '.' %}
                    <button type="button" 
                            class="status-btn px-3 py-2 rounded-xl text-xs font-bold transition-all active:scale-95 flex items-center justify-center gap-1 {% if is_reset %}bg-slate-300 text-slate-700{% else %}bg-slate-100 text-slate-400 hover:bg-slate-200 border border-slate-200{% endif %}" 
                            data-status="." 
                            title="Réinitialiser votre réponse">
                        ⊘
                    </button>
                {% endif %}
            </div>
        </div>
    {% endif %}

</div>