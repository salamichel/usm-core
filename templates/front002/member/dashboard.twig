{% extends "base.twig" %}
{% block title %}Mon Tableau de Bord — USM Volley{% endblock %}

{% block content %}
{# pb-36 sur mobile pour laisser de l'espace à la barre fixe du bas, md:pb-12 sur ordinateur #}
<div class="min-h-screen bg-slate-50/50 pb-36 md:pb-12">
    
    {# 1. EN-TÊTE ET ACCUEIL #}
    <div class="bg-slate-900 text-white pt-8 pb-20 md:pt-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">Bonjour, {{ app.session.user_name }} 👋</h1>
                    <p class="text-slate-400 text-sm md:text-base mt-1">Voici le résumé de votre activité et des événements à venir.</p>
                </div>
                
                <div class="hidden md:flex flex-wrap gap-3">
                    <a href="{{ url('member/profile') }}" class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-lg font-medium transition flex items-center gap-2 text-sm shadow-sm">
                        <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        Mon profil
                    </a>
                    <a href="{{ url('agenda?view=table&hide_empty_players=1') }}" class="bg-[var(--primary)] hover:bg-[var(--primary)]/90 text-white px-4 py-2 rounded-lg font-medium transition flex items-center gap-2 text-sm shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        Voir tout l'agenda
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 -mt-10">
        
        {% if is_capitaine %}
        <div class="bg-gradient-to-r from-amber-500 to-amber-600 rounded-3xl p-5 mb-8 text-slate-900 shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-4 border border-amber-400">
            <div>
                <h2 class="text-lg font-black flex items-center gap-2">
                    👑 Espace Capitaine
                </h2>
                <p class="text-sm font-medium text-slate-900/80 mt-1">Vous êtes capitaine pour cette saison. Gérez les convocations de vos joueurs et créez des matchs.</p>                
            </div>
            <a href="{{ url('member/captain') }}" class="bg-slate-900 hover:bg-slate-800 text-white font-bold px-4 py-2.5 rounded-xl transition text-center text-sm shadow-sm flex-shrink-0">
                Accéder à l'espace
            </a>
        </div>
        {% endif %}
        
        {# 2. KPI MÉTRIQUES RAPIDES (Périodes & Actions) #}
        <div class="grid grid-cols-3 gap-2 sm:gap-4 mb-6 md:mb-8">
            <div class="bg-white rounded-2xl p-2.5 sm:p-5 shadow-sm border border-slate-100 flex flex-col sm:flex-row items-center text-center sm:text-left gap-1.5 sm:gap-4 hover:-translate-y-1 transition-all cursor-pointer hover:shadow-md hover:border-slate-200 duration-200 select-none" data-kpi-filter="this-week">
                <div class="w-8 h-8 sm:w-12 sm:h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <div class="min-w-0">
                    <p class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider truncate">
                        <span class="sm:hidden">Cette sem.</span>
                        <span class="hidden sm:inline">Cette semaine</span>
                    </p>
                    <div class="flex items-baseline justify-center sm:justify-start gap-1 mt-0.5">
                        <span class="text-lg sm:text-2xl font-black text-slate-900">{{ kpis.this_week }}</span>
                        <span class="hidden sm:inline text-xs font-medium text-slate-500">événements</span>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-2.5 sm:p-5 shadow-sm border border-slate-100 flex flex-col sm:flex-row items-center text-center sm:text-left gap-1.5 sm:gap-4 hover:-translate-y-1 transition-all cursor-pointer hover:shadow-md hover:border-slate-200 duration-200 select-none" data-kpi-filter="next-week">
                <div class="w-8 h-8 sm:w-12 sm:h-12 rounded-full bg-sky-50 text-sky-600 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <div class="min-w-0">
                    <p class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider truncate">
                        <span class="sm:hidden">Suivante</span>
                        <span class="hidden sm:inline">Sem. prochaine</span>
                    </p>
                    <div class="flex items-baseline justify-center sm:justify-start gap-1 mt-0.5">
                        <span class="text-lg sm:text-2xl font-black text-slate-900">{{ kpis.next_week }}</span>
                        <span class="hidden sm:inline text-xs font-medium text-slate-500">événements</span>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-2.5 sm:p-5 shadow-sm border {% if kpis.action_required > 0 %}border-amber-300 border-l-4 border-l-amber-500{% else %}border-slate-100{% endif %} flex flex-col sm:flex-row items-center text-center sm:text-left gap-1.5 sm:gap-4 hover:-translate-y-1 transition-all cursor-pointer hover:shadow-md hover:border-amber-400 duration-200 select-none" data-kpi-filter="action-required">
                <div class="w-8 h-8 sm:w-12 sm:h-12 rounded-full bg-amber-50 text-amber-500 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                </div>
                <div class="min-w-0">
                    <p class="text-[10px] sm:text-xs font-bold {% if kpis.action_required > 0 %}text-amber-700{% else %}text-slate-400{% endif %} uppercase tracking-wider truncate">
                        À répondre
                    </p>
                    <div class="flex items-baseline justify-center sm:justify-start gap-1 mt-0.5">
                        <span class="text-lg sm:text-2xl font-black text-slate-900">{{ kpis.action_required }}</span>
                        <span class="hidden sm:inline text-xs font-medium text-slate-500">événements</span>
                    </div>
                </div>
            </div>
        </div>

        {# 3. CONTENU PRINCIPAL (Grille) #}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            {# COLONNE GAUCHE : Prochains événements #}
            <div id="imminent-section" class="lg:col-span-2 space-y-4">
                <div class="flex items-center justify-between">
                    <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                        <svg class="w-5 h-5 text-[var(--primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Événements à venir<span id="active-filter-label" class="text-sm font-normal text-slate-500 italic ml-2"></span>
                    </h2>
                    <button id="reset-dashboard-filters" class="hidden text-xs font-semibold text-slate-500 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 px-2.5 py-1.5 rounded-lg transition flex items-center gap-1 cursor-pointer">
                        ✕ Effacer les filtres
                    </button>
                </div>

                {# Panneau Filtres & Actions groupées clairement dissociés #}
                <div class="bg-white rounded-3xl p-5 border border-slate-100 shadow-sm mb-6 space-y-4">
                    {# Section 1 : Filtres instantanés #}
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="text-xs font-black uppercase tracking-wider text-slate-600 flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                                <span>Filtrer l'affichage</span>
                            </h3>
                            <span class="text-[11px] text-slate-400 font-semibold italic">Filtrage instantané en direct</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                            {# 1. Sélectionner le Type #}
                            <div>
                                <label for="bulk-type-select" class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Type</label>
                                <select id="bulk-type-select" class="w-full text-xs rounded-xl border border-slate-200 bg-white px-3 py-2 text-slate-700 font-semibold focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all cursor-pointer">
                                    <option value="">Tous les types</option>
                                </select>
                            </div>

                            {# 2. Sélectionner le Sous-Type #}
                            <div>
                                <label for="bulk-subtype-select" class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Sous-Type (Équipe)</label>
                                <select id="bulk-subtype-select" class="w-full text-xs rounded-xl border border-slate-200 bg-white px-3 py-2 text-slate-700 font-semibold focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all cursor-pointer">
                                    <option value="">Tous les sous-types</option>
                                </select>
                            </div>

                            {# 3. Sélectionner le Lieu #}
                            <div>
                                <label for="bulk-location-select" class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Lieu</label>
                                <select id="bulk-location-select" class="w-full text-xs rounded-xl border border-slate-200 bg-white px-3 py-2 text-slate-700 font-semibold focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all cursor-pointer">
                                    <option value="">Tous les lieux</option>
                                </select>
                            </div>

                            {# 4. Nature : Dispo ou Présence #}
                            <div>
                                <label for="bulk-kind-select" class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Nature</label>
                                <select id="bulk-kind-select" class="w-full text-xs rounded-xl border border-slate-200 bg-white px-3 py-2 text-slate-700 font-semibold focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all cursor-pointer">
                                    <option value="">Dispos & Présences</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    {# Section 2 : Modification groupée de statut #}
                    <div class="pt-3 border-t border-slate-100 bg-slate-50/70 -mx-5 -mb-5 p-4 rounded-b-3xl">
                        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
                            <div class="flex-grow">
                                <label for="bulk-status-select" class="block text-[10px] font-bold uppercase tracking-wider text-indigo-700 mb-1">⚡ Modifier en lot le statut des événements affichés</label>
                                <select id="bulk-status-select" class="w-full text-xs rounded-xl border border-indigo-200 bg-white px-3 py-2.5 text-slate-800 font-bold focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all cursor-pointer">
                                    <option value="">Choisir un statut à attribuer...</option>
                                    <option value="Disponible">Disponible / Présent</option>
                                    <option value="Disponible si nécessaire">Si besoin (Matchs uniquement)</option>
                                    <option value="Indisponible">Indisponible / Absent</option>
                                    <option value=".">Réinitialiser (Sans réponse)</option>
                                </select>
                            </div>
                            <div class="sm:w-64 flex-shrink-0">
                                <button type="button" id="bulk-apply-btn" class="w-full text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl transition-all shadow-sm active:scale-98 flex items-center justify-center gap-1.5 cursor-pointer">
                                    <span>Appliquer à ces</span>
                                    <span id="bulk-target-count" class="bg-indigo-800 px-1.5 py-0.5 rounded text-[11px] font-mono font-black">{{ imminent_events|length }}</span>
                                    <span>événement(s)</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="space-y-4" id="event-grid" 
                     data-logged-in-user-id="{{ app.session.LogInId|default(0) }}" 
                     data-logged-in-user-name="{{ app.session.user_name|default('') }}">
                    {% for m in imminent_events %}
                        {% include "agenda/_event_card.twig" with {
                            'm': m, 
                            'allow_actions': true, 
                            'show_link': true,
                            'is_first': loop.first
                        } %}
                    {% else %}
                        <div class="p-8 text-center bg-white rounded-2xl border border-slate-100 text-slate-400 text-sm">
                            Aucun événement imminent.
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# COLONNE DROITE : Analytiques & Répartitions #}
            <div class="space-y-6">
                <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                    <svg class="w-5 h-5 text-[var(--primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    Statistiques: {{ saison_active }}
                </h2>

                {# Bloc : Ma présence #}
                <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Mon Taux de Présence</h3>
                    
                    <div class="cursor-pointer hover:bg-slate-50 p-1.5 rounded-xl transition-all" data-type-filter="match">
                        <div class="mb-1.5 flex justify-between text-sm font-medium">
                            <span class="text-slate-600">Matchs</span>
                            <span class="text-slate-900 font-bold">{{ stats.presence_match }}%</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2 mb-2">
                            <div class="bg-blue-500 h-2 rounded-full" style="width: {{ stats.presence_match }}%"></div>
                        </div>
                    </div>

                    <div class="cursor-pointer hover:bg-slate-50 p-1.5 rounded-xl transition-all" data-type-filter="entrainement">
                        <div class="mb-1.5 flex justify-between text-sm font-medium">
                            <span class="text-slate-600">Entraînements</span>
                            <span class="text-slate-900 font-bold">{{ stats.presence_training }}%</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2 mb-2">
                            <div class="bg-orange-400 h-2 rounded-full" style="width: {{ stats.presence_training }}%"></div>
                        </div>
                    </div>

                    <div class="cursor-pointer hover:bg-slate-50 p-1.5 rounded-xl transition-all" data-type-filter="tournois">
                        <div class="mb-1.5 flex justify-between text-sm font-medium">
                            <span class="text-slate-600">Tournois</span>
                            <span class="text-slate-900 font-bold">{{ stats.presence_tournament }}%</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2">
                            <div class="bg-purple-500 h-2 rounded-full" style="width: {{ stats.presence_tournament }}%"></div>
                        </div>
                    </div>
                </div>

                {# Bloc : Par Type #}
                <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Événements par type</h3>
                    <div class="space-y-1">
                        {% set colors = {
                            'match': 'bg-blue-500',
                            'entraînement': 'bg-orange-400',
                            'entrainement': 'bg-orange-400',
                            'tournoi': 'bg-purple-500',
                            'stage': 'bg-indigo-500',
                            'beach': 'bg-yellow-500',
                            'club': 'bg-rose-500',
                            'forum': 'bg-teal-500'
                        } %}
                        {% set labels = {
                            'match': 'Matchs',
                            'entraînement': 'Entraînements',
                            'entrainement': 'Entraînements',
                            'tournoi': 'Tournois',
                            'stage': 'Stages',
                            'beach': 'Beach',
                            'club': 'Club',
                            'forum': 'Forums'
                        } %}
                        {% for type, count in stats.events_by_type %}
                            {% set type_key = type|lower %}
                            {% set bullet_color = colors[type_key] | default('bg-slate-400') %}
                            {% set display_label = labels[type_key] | default(type) %}
                            <div class="flex items-center justify-between cursor-pointer hover:bg-slate-50 p-1.5 rounded-lg transition-colors" data-type-filter="{{ type|lower }}">
                                <div class="flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full {{ bullet_color }}"></span>
                                    <span class="text-sm font-medium text-slate-600">{{ display_label }}</span>
                                </div>
                                <span class="text-xs font-bold text-slate-900 bg-slate-100 px-2 py-0.5 rounded-md">{{ count }}</span>
                            </div>
                        {% else %}
                            <div class="text-xs text-slate-400 p-1.5 text-center bg-slate-50 rounded-xl py-4 border border-slate-100">Aucun type d'événement.</div>
                        {% endfor %}
                    </div>
                </div>

                {# Bloc : Lieux #}
                <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Top Lieux (À venir)</h3>
                    <ul class="space-y-1">
                        {% for lieu in stats.top_lieux %}
                            <li class="flex items-center justify-between cursor-pointer hover:bg-slate-50 p-1.5 rounded-lg transition-colors" data-lieu-filter="{{ lieu.nom }}">
                                <span class="text-sm text-slate-600 truncate max-w-[200px]">{{ lieu.nom }}</span>
                                <span class="text-xs font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">{{ lieu.count }}</span>
                            </li>
                        {% else %}
                            <li class="text-xs text-slate-400 p-1.5">Aucun lieu recensé.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

    {% include "agenda/_player_modal.twig" %}
</div>
{% endblock %}

{% block scripts %}
    <script src="{{ url('assets/front002/js/agenda-cards.js') }}?v=1.1"></script>
{% endblock %}