{# Partial : Tableau croisé limité aux affectations du membre connecté #}
<div id="member-table-container" class="hidden space-y-4">
  {# Toolbar Zoom & Astuce #}
  <div class="bg-white rounded-3xl p-4 flex flex-wrap items-center justify-between gap-4 border border-slate-100 shadow-sm">
    <div class="flex items-center gap-3">
      <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Zoom</span>
      <div class="flex gap-1">
        <button type="button" data-member-zoom="1" class="member-zoom-btn px-3 py-1.5 text-xs rounded-xl border border-slate-200 bg-white hover:bg-slate-50 font-bold text-slate-700 transition cursor-pointer">100%</button>
        <button type="button" data-member-zoom="0.8" class="member-zoom-btn px-3 py-1.5 text-xs rounded-xl border border-slate-200 bg-white hover:bg-slate-50 font-bold text-slate-700 transition cursor-pointer">80%</button>
        <button type="button" data-member-zoom="0.65" class="member-zoom-btn px-3 py-1.5 text-xs rounded-xl border border-slate-200 bg-white hover:bg-slate-50 font-bold text-slate-700 transition cursor-pointer">65%</button>
        <button type="button" data-member-zoom="0.5" class="member-zoom-btn px-3 py-1.5 text-xs rounded-xl border border-slate-200 bg-white hover:bg-slate-50 font-bold text-slate-700 transition cursor-pointer">50%</button>
      </div>
    </div>

    <div class="flex items-center gap-2 text-xs font-semibold text-indigo-700 bg-indigo-50 border border-indigo-100 rounded-xl px-3 py-2">
      <span class="text-indigo-500">💡</span>
      <span>Cliquez sur les cases de votre ligne pour modifier vos présences en direct.</span>
    </div>
  </div>

  {% if member_cross_table.manifestations is empty %}
    <div class="p-8 text-center bg-white rounded-2xl border border-slate-100 text-slate-400 text-sm">
      Aucun événement imminent pour vos affectations.
    </div>
  {% else %}
    <div class="agenda-table-container bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden" style="max-height:75vh; overflow-y:auto; overflow-x:auto;">
      <table class="border-collapse text-sm whitespace-nowrap member-agenda-table"
             data-statuses-match="{{ statuses.match|default([])|json_encode|e('html_attr') }}"
             data-statuses-entrainement="{{ statuses.entrainement|default([])|json_encode|e('html_attr') }}">
        <thead class="sticky top-0 z-20 bg-slate-50">
          <tr>
            <th class="sticky-left z-30 bg-slate-100 border-b border-r border-slate-200 px-3 py-3 text-left font-semibold min-w-[160px] text-slate-700">
              <div class="text-xs uppercase tracking-wider flex items-center gap-1">
                <span id="member-table-player-count" class="normal-case text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-200 text-slate-700 border border-slate-300/60">{{ member_cross_table.joueurs|length }}</span>
                <span>Joueurs</span>
              </div>
            </th>

            {% for mid, m in member_cross_table.manifestations %}
              {% if 'Match' in m.type %}
                {% set type_icon       = '🏆' %}
                {% set type_text_color = 'text-indigo-600' %}
                {% set icon_color      = 'text-indigo-400' %}
                {% set type_border     = 'border-t-2 border-t-indigo-500' %}
                {% set type_bg         = 'bg-indigo-50/40' %}
              {% elseif 'Entra' in m.type %}
                {% set type_icon       = '🏐' %}
                {% set type_text_color = 'text-teal-600' %}
                {% set icon_color      = 'text-teal-400' %}
                {% set type_border     = 'border-t-2 border-t-teal-500' %}
                {% set type_bg         = 'bg-teal-50/40' %}
              {% else %}
                {% set type_icon       = '📅' %}
                {% set type_text_color = 'text-slate-500' %}
                {% set icon_color      = 'text-slate-400' %}
                {% set type_border     = 'border-t-2 border-t-[var(--primary)]' %}
                {% set type_bg         = 'bg-white' %}
              {% endif %}

              {% if m.annule %}
                {% set col_top = 'border-t-2 border-t-rose-400' %}
                {% set col_bg  = 'bg-rose-50/50' %}
              {% elseif m.provisoire %}
                {% set col_top = 'border-t-2 border-t-amber-400' %}
                {% set col_bg  = 'bg-amber-50/40' %}
              {% else %}
                {% set col_top = type_border %}
                {% set col_bg  = type_bg %}
              {% endif %}

              {% set total_committed = (m.nb_selected|default(m.nb_selection|default(0))) + (m.nb_available|default(m.nb_disponible|default(0))) + (m.nb_available_if_needed|default(m.nb_disponible_si_necessaire|default(0))) + (m.nb_present|default(0)) %}
              {% set ok = total_committed >= (m.min_players|default(6)) %}

              <th class="border-b border-r border-slate-200 {{ col_top }} {{ col_bg }} px-3 py-3 text-left font-normal min-w-[175px] align-top"
                  data-manifestation-col="{{ mid }}"
                  data-manifestation-header="{{ mid }}">
                <div class="flex items-center justify-between gap-1 mb-2">
                  <span class="flex items-center gap-1 text-[10px] font-semibold uppercase tracking-widest {{ type_text_color }}">
                    <span>{{ type_icon }}</span>
                    <span>{{ m.type }}</span>
                  </span>
                  {% if m.annule %}
                    <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-rose-100 text-rose-700">Annulé</span>
                  {% elseif m.provisoire %}
                    <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">Provisoire</span>
                  {% else %}
                    <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700">Confirmé</span>
                  {% endif %}
                </div>

                <a href="{{ url('agenda/' ~ mid) }}" class="block font-serif font-semibold text-base text-slate-900 leading-snug mb-2 hover:text-indigo-600 hover:underline">
                  {{ m.titre }}
                </a>

                <div class="space-y-1 text-xs text-slate-600 mb-2">
                  <div class="flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 shrink-0 {{ icon_color }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    <span>{{ m.date_display }}</span>
                  </div>
                  {% if m.time_range %}
                    <div class="flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 shrink-0 {{ icon_color }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      <span>{{ m.time_range }}</span>
                    </div>
                  {% endif %}
                  {% if m.lieu %}
                    <div class="flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 shrink-0 {{ icon_color }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                      <span>{{ m.lieu }}</span>
                    </div>
                  {% endif %}
                </div>

                <div class="border-t border-slate-200 pt-2 space-y-1.5 text-[11px]" data-stats-container="{{ mid }}">
                  {% if 'Match' in m.type %}
                    <div class="px-2 py-1 rounded font-semibold text-xs text-center {% if ok %}text-emerald-700 bg-emerald-50{% else %}text-rose-700 bg-rose-50{% endif %}" data-team-badge="{{ mid }}">
                      {% if ok %}✓ Équipe OK{% else %}⚠ Sous-effectif{% endif %}
                    </div>
                    <div class="flex flex-wrap gap-x-2 gap-y-0.5">
                      <span class="text-amber-700 {% if m.nb_selection == 0 %}hidden{% endif %}" data-stat-wrap="selection-{{ mid }}">Sélection: <strong data-stat="selection-{{ mid }}">{{ m.nb_selection }}</strong></span>
                      <span class="text-emerald-700 {% if m.nb_present == 0 %}hidden{% endif %}" data-stat-wrap="present-{{ mid }}">Présents: <strong data-stat="present-{{ mid }}">{{ m.nb_present_confirmed|default(m.nb_present) }}</strong></span>
                    </div>
                    <div class="flex flex-wrap gap-x-2 gap-y-0.5">
                      <span class="text-blue-700 {% if m.nb_disponible == 0 %}hidden{% endif %}" data-stat-wrap="disponible-{{ mid }}">Dispos: <strong data-stat="disponible-{{ mid }}">{{ m.nb_disponible }}</strong></span>
                      <span class="text-rose-700 {% if m.nb_indisponible == 0 %}hidden{% endif %}" data-stat-wrap="indisponible-{{ mid }}">Indispos: <strong data-stat="indisponible-{{ mid }}">{{ m.nb_indisponible }}</strong></span>
                    </div>
                  {% else %}
                    <div class="flex flex-wrap gap-x-2 gap-y-0.5 items-center">
                      <span class="text-emerald-700" data-stat-wrap="present-{{ mid }}">Présents: <strong data-stat="present-{{ mid }}">{{ m.nb_present_confirmed|default(m.nb_present) }}</strong></span>
                      <span class="text-amber-800 font-extrabold bg-amber-100 border border-amber-200 px-1.5 py-0.5 rounded-full text-[10px] {% if not (m.nb_waiting is defined and m.nb_waiting > 0) %}hidden{% endif %}" data-stat-wrap="waiting-{{ mid }}">
                        ⏳ +<strong data-stat="waiting-{{ mid }}">{{ m.nb_waiting|default(0) }}</strong>
                      </span>
                      <span class="text-rose-700" data-stat-wrap="absent-{{ mid }}">Absents: <strong data-stat="absent-{{ mid }}">{{ m.nb_absent }}</strong></span>
                    </div>
                  {% endif %}
                </div>
              </th>
            {% endfor %}
          </tr>
        </thead>

        <tbody>
          {% for jid, nom in member_cross_table.joueurs %}
            {% set row = member_cross_table.cross[jid] %}
            {% set is_current_user = currentUserId is defined and currentUserId and (jid == currentUserId) %}

            <tr class="{{ loop.index is odd ? 'bg-white' : 'bg-slate-50/50' }} hover:bg-amber-50/40 {% if is_current_user %}bg-indigo-50/20{% endif %}"
                data-player-row="{{ jid }}"
                data-is-current-user="{{ is_current_user ? '1' : '0' }}">
              <td class="sticky-left z-10 border-b border-r border-slate-200 px-3 py-2 font-medium bg-slate-50 min-w-[160px] text-slate-800 {% if is_current_user %}ring-2 ring-indigo-500/50 bg-indigo-50/80 font-bold text-indigo-950{% endif %}">
                {% set parts = nom|split(' ') %}
                {% set nom_famille = parts[0] %}
                {% set prenom = parts|last %}
                <span class="text-xs">{{ nom_famille|upper }} {{ prenom }}</span>
                {% if is_current_user %}
                  <span class="ml-1 px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-[var(--primary)] text-white shadow-sm inline-block">Vous</span>
                  <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-amber-100 text-amber-800 border border-amber-200 shadow-sm inline-flex items-center" title="Cliquez sur les cases de votre ligne pour modifier vos disponibilités en direct">✏️</span>
                {% endif %}
              </td>

              {% for mid, m in member_cross_table.manifestations %}
                {% set part = row[mid] ?? null %}
                {% set is_selected = part and part.category == 'selected' %}
                {% set is_present = part and part.category == 'present' %}
                {% set is_waiting = part and part.is_waiting %}
                {% set is_available_if_needed = part and part.category == 'available_if_needed' %}
                {% set is_available = part and part.category == 'available' %}
                {% set is_unavailable = part and part.category == 'unavailable' %}
                {% set is_absent = part and part.category == 'absent' %}
                {% set is_unknown = part and part.category == 'unknown' %}

                {% if is_selected %}
                  {% set cell_bg = 'bg-amber-100' %}{% set text_color = 'text-amber-800' %}
                {% elseif is_present %}
                  {% if is_waiting %}
                    {% set cell_bg = 'bg-amber-100' %}{% set text_color = 'text-amber-900 font-bold' %}
                  {% else %}
                    {% set cell_bg = 'bg-emerald-100' %}{% set text_color = 'text-emerald-800' %}
                  {% endif %}
                {% elseif is_available %}
                  {% set cell_bg = 'bg-sky-100' %}{% set text_color = 'text-sky-800' %}
                {% elseif is_available_if_needed %}
                  {% set cell_bg = 'bg-cyan-100' %}{% set text_color = 'text-cyan-800' %}
                {% elseif is_unavailable or is_absent %}
                  {% set cell_bg = 'bg-rose-100' %}{% set text_color = 'text-rose-800' %}
                {% elseif is_unknown %}
                  {% set cell_bg = 'bg-gray-100' %}{% set text_color = 'text-gray-800' %}
                {% else %}
                  {% set cell_bg = 'bg-white' %}{% set text_color = 'text-gray-400' %}
                {% endif %}

                {% if m.annule %}
                  {% set cell_bg = 'bg-rose-200' %}{% set text_color = 'text-rose-900' %}
                {% elseif m.provisoire %}
                  {% set cell_bg = 'bg-amber-100' %}{% set text_color = 'text-amber-800' %}
                {% endif %}

                {% if is_selected %}
                  {% set icone = '★' %}{% set libelle = 'Sél.' %}
                {% elseif is_present %}
                  {% if is_waiting %}
                    {% set icone = '⏳' %}{% set libelle = 'Att. +' ~ part.waiting_position %}
                  {% else %}
                    {% set icone = '✓' %}{% set libelle = part.companion_count > 0 ? 'Prés. à ' ~ (part.companion_count + 1) : 'Prés.' %}
                  {% endif %}
                {% elseif is_available_if_needed %}
                  {% set icone = '○' %}{% set libelle = 'Si néc.' %}
                {% elseif is_available %}
                  {% set icone = '◐' %}{% set libelle = 'Dispo' %}
                {% elseif is_unavailable %}
                  {% set icone = '✗' %}{% set libelle = 'Indispo' %}
                {% elseif is_absent %}
                  {% set icone = '✗' %}{% set libelle = 'Absent' %}
                {% elseif is_unknown %}
                  {% set icone = '?' %}{% set libelle = '?' %}
                {% else %}
                  {% set icone = '—' %}{% set libelle = 'S.R.' %}
                {% endif %}

                {% set is_user_cell = is_current_user and not m.annule %}

                <td class="border-b border-r border-slate-200 px-2 py-1.5 text-center font-medium {{ cell_bg }} {{ text_color }} {% if is_user_cell %}cursor-pointer hover:ring-2 hover:ring-[var(--primary)] hover:z-20 transition-all select-none relative group{% endif %}"
                    data-col-mid="{{ mid }}"
                    data-cell-cat="{{ part ? part.category : 'no_response' }}"
                    {% if is_user_cell %}
                      data-user-cell="true"
                      data-manifestation-id="{{ mid }}"
                      data-player-id="{{ jid }}"
                      data-current-status="{{ part ? part.text : '' }}"
                      data-event-type="{{ 'Match' in m.type ? 'match' : 'other' }}"
                      data-is-selected="{{ is_selected ? '1' : '0' }}"
                      data-is-cancelled="{{ m.annule ? '1' : '0' }}"
                      title="{{ is_waiting ? 'En attente (+' ~ part.waiting_position ~ ') — Cliquez pour modifier' : 'Cliquer pour modifier votre présence' }}"
                    {% else %}
                      title="{{ part ? part.text : '' }}"
                    {% endif %}>
                  <span class="cell-icon text-sm">{{ icone }}</span>
                  <span class="cell-label text-xs">{{ libelle }}</span>
                  {% if is_user_cell %}
                    <span class="absolute right-1 top-0.5 text-[10px] opacity-75 group-hover:opacity-100 group-hover:scale-125 transition-all text-slate-500 drop-shadow-sm pointer-events-none select-none">✏️</span>
                  {% endif %}
                </td>
              {% endfor %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>

<style>
  .agenda-table-container {
    position: relative;
    touch-action: manipulation;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 #f1f5f9;
  }
  .member-agenda-table thead {
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .member-agenda-table th.sticky-left {
    position: sticky;
    left: 0;
    z-index: 30;
  }
  .member-agenda-table td.sticky-left {
    position: sticky;
    left: 0;
    z-index: 10;
  }
  .member-zoom-btn.active {
    background-color: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }
</style>
