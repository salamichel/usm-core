{% extends "base.twig" %}
{% block title %}Modifier la Rencontre — USM Volley{% endblock %}

{% block content %}
<div class="min-h-screen bg-slate-50/50 pb-24 md:pb-12">
    
    {# En-tête #}
    <div class="bg-slate-900 text-white pt-8 pb-20 md:pt-12">
        <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="flex items-center gap-4">
                <a href="{{ url('member/captain') }}" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                </a>
                <div>
                    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">Modifier la Rencontre</h1>
                    <p class="text-slate-400 text-sm mt-1">Mettez à jour les informations du match ou plateau pour l'équipe {{ team.libelle }}.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 -mt-10">
        <div class="bg-white rounded-3xl p-6 md:p-8 border border-slate-100 shadow-sm">
            <form method="POST" action="{{ url('member/captain/matches/' ~ event.id ~ '/edit') }}" class="space-y-6" id="match-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

                {# Type de rencontre : Match simple ou Plateau #}
                {% set isInitialPlateau = (current_encounters|length > 1) or (current_result.is_plateau is defined and current_result.is_plateau) %}
                <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-2xl space-y-3">
                    <label class="block text-sm font-bold text-slate-900">Type de rencontre *</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <label class="cursor-pointer border rounded-xl p-3.5 flex items-center gap-3 transition bg-white {% if not isInitialPlateau %}border-amber-500 ring-2 ring-amber-500/20{% else %}border-slate-200 hover:border-slate-300{% endif %}" id="label-mode-match">
                            <input type="radio" name="event_nature" value="match" {% if not isInitialPlateau %}checked{% endif %} class="text-amber-500 focus:ring-amber-400" id="radio-mode-match">
                            <div>
                                <span class="block text-sm font-bold text-slate-900">🏐 Match simple</span>
                                <span class="block text-xs text-slate-500">Une seule équipe adverse</span>
                            </div>
                        </label>
                        <label class="cursor-pointer border rounded-xl p-3.5 flex items-center gap-3 transition bg-white {% if isInitialPlateau %}border-amber-500 ring-2 ring-amber-500/20{% else %}border-slate-200 hover:border-slate-300{% endif %}" id="label-mode-plateau">
                            <input type="radio" name="event_nature" value="plateau" {% if isInitialPlateau %}checked{% endif %} class="text-amber-500 focus:ring-amber-400" id="radio-mode-plateau">
                            <div>
                                <span class="block text-sm font-bold text-slate-900">🎪 Plateau multi-équipes</span>
                                <span class="block text-xs text-slate-500">2 équipes adverses ou plus</span>
                            </div>
                        </label>
                    </div>
                </div>

                {# SECTION ADVERSAIRE : MATCH SIMPLE #}
                <div id="section-match-single" class="p-4 bg-slate-50 border border-slate-200/80 rounded-2xl space-y-3 {% if isInitialPlateau %}hidden{% endif %}">
                    <div class="flex items-center justify-between">
                        <label for="opponent_team_id" class="block text-sm font-bold text-slate-900">Équipe adverse *</label>
                        <button type="button" id="btn-toggle-new-single" class="text-xs font-bold text-amber-600 hover:text-amber-700 transition flex items-center gap-1 cursor-pointer">
                            + Ajouter une équipe non listée
                        </button>
                    </div>

                    {# Mode existant #}
                    <div id="single-existing-box">
                        <select id="opponent_team_id" name="opponent_team_id" {% if not isInitialPlateau %}required{% else %}disabled{% endif %}
                                class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-sm text-slate-800 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20">
                            <option value="">-- Sélectionner l'équipe adverse --</option>
                            {% for ot in opponent_teams %}
                                <option value="{{ ot.id }}" {% if current_result and current_result.opponent_team_id == ot.id %}selected{% endif %}>
                                    {{ ot.name }}{% if ot.city %} ({{ ot.city }}){% endif %}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Mode nouveau #}
                    <div id="single-new-box" class="space-y-3 pt-2 border-t border-slate-200 hidden">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Nom complet de l'équipe adverse *</label>
                            <input type="text" id="new_opponent_name" name="new_opponent_name" placeholder="ex: VB Club Toulonnais 2" disabled
                                   class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20">
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Club (optionnel)</label>
                                <input type="text" id="new_opponent_club" name="new_opponent_club" placeholder="ex: VBC Toulon" disabled
                                       class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm text-slate-800 focus:border-amber-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Ville (optionnel)</label>
                                <input type="text" id="new_opponent_city" name="new_opponent_city" placeholder="ex: Toulon" disabled
                                       class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm text-slate-800 focus:border-amber-500 focus:outline-none">
                            </div>
                        </div>
                    </div>
                </div>

                {# SECTION ADVERSAIRES : PLATEAU MULTI-ÉQUIPES #}
                <div id="section-match-plateau" class="p-4 bg-slate-50 border border-slate-200/80 rounded-2xl space-y-4 {% if not isInitialPlateau %}hidden{% endif %}">
                    <div class="flex items-center justify-between">
                        <div>
                            <label class="block text-sm font-bold text-slate-900">Équipes adverses du plateau *</label>
                            <p class="text-xs text-slate-500">Sélectionnez les équipes affrontées lors de ce plateau (au moins 2).</p>
                        </div>
                    </div>

                    <div id="plateau-opponents-list" class="space-y-3">
                        {# Rangées générées dynamiquement ou initialisées via JS #}
                    </div>

                    <div class="pt-2">
                        <button type="button" id="btn-add-plateau-opponent" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300 transition">
                            <span>+</span> Ajouter une équipe au plateau
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                    {# Date & Heure #}
                    <div>
                        <label for="date" class="block text-sm font-semibold text-slate-700 mb-2">Date et Heure *</label>
                        <input type="datetime-local" id="date" name="date" required value="{{ date_value }}"
                               class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-sm text-slate-800 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20">
                    </div>

                    {# Durée #}
                    <div>
                        <label for="duration" class="block text-sm font-semibold text-slate-700 mb-2">Durée estimée *</label>
                        <select id="duration" name="duration" required
                                class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-sm text-slate-800 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20">
                            {% for dur in durations %}
                                <option value="{{ dur }}" {% if dur == event.duration %}selected{% endif %}>{{ dur }}</option>
                            {% else %}
                                <option value="2h" {% if event.duration == '2h' %}selected{% endif %}>2h</option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Statut #}
                    <div>
                        <label for="statut" class="block text-sm font-semibold text-slate-700 mb-2">Statut *</label>
                        <select id="statut" name="statut" required
                                class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-sm text-slate-800 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20">
                            {% for st in statuses %}
                                <option value="{{ st }}" {% if st == event.statut %}selected{% endif %}>{{ st }}</option>
                            {% else %}
                                <option value="Confirmé" {% if event.statut == 'Confirmé' %}selected{% endif %}>Confirmé</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                {# Lieu #}
                <div>
                    <label for="location" class="block text-sm font-semibold text-slate-700 mb-2">Lieu / Gymnase *</label>
                    <select id="location" name="location" required
                            class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-sm text-slate-800 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20">
                        <option value="" disabled>Choisir un lieu...</option>
                        {% for loc in locations %}
                            <option value="{{ loc }}" {% if loc == event.lieu %}selected{% endif %}>{{ loc }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# Commentaire #}
                <div>
                    <label for="commentaire" class="block text-sm font-semibold text-slate-700 mb-2">Commentaires / Consignes</label>
                    <textarea id="commentaire" name="commentaire" rows="4" placeholder="Ex: Rendez-vous à 19h30 pour l'échauffement. Maillot bleu."
                              class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-sm text-slate-800 placeholder-slate-400 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20">{{ event.commentaire }}</textarea>
                </div>

                {# Actions #}
                <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row justify-end gap-3">
                    <a href="{{ url('member/captain') }}"
                       class="text-sm font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-3 rounded-xl transition text-center">
                        Annuler
                    </a>
                    <button type="submit"
                            class="text-sm font-bold bg-amber-500 hover:bg-amber-600 text-slate-900 px-5 py-3 rounded-xl transition text-center shadow-sm">
                        Enregistrer les modifications
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{# Référentiel des équipes et rencontres actuelles en JSON #}
<script id="opponent-teams-data" type="application/json">{{ opponent_teams|json_encode|raw }}</script>
<script id="current-encounters-data" type="application/json">{{ current_encounters|json_encode|raw }}</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const opponentTeams = JSON.parse(document.getElementById('opponent-teams-data').textContent || '[]');
    const currentEncounters = JSON.parse(document.getElementById('current-encounters-data').textContent || '[]');

    // 1. Basculement Mode Match Simple vs Plateau
    const radioMatch = document.getElementById('radio-mode-match');
    const radioPlateau = document.getElementById('radio-mode-plateau');
    const labelMatch = document.getElementById('label-mode-match');
    const labelPlateau = document.getElementById('label-mode-plateau');
    const sectionSingle = document.getElementById('section-match-single');
    const sectionPlateau = document.getElementById('section-match-plateau');

    function updateModeDisplay() {
        const isPlateau = radioPlateau.checked;
        if (isPlateau) {
            sectionSingle.classList.add('hidden');
            sectionPlateau.classList.remove('hidden');
            labelPlateau.classList.add('border-amber-500', 'ring-2', 'ring-amber-500/20');
            labelPlateau.classList.remove('border-slate-200');
            labelMatch.classList.remove('border-amber-500', 'ring-2', 'ring-amber-500/20');
            labelMatch.classList.add('border-slate-200');

            toggleSingleInputs(false);
            togglePlateauInputs(true);
        } else {
            sectionSingle.classList.remove('hidden');
            sectionPlateau.classList.add('hidden');
            labelMatch.classList.add('border-amber-500', 'ring-2', 'ring-amber-500/20');
            labelMatch.classList.remove('border-slate-200');
            labelPlateau.classList.remove('border-amber-500', 'ring-2', 'ring-amber-500/20');
            labelPlateau.classList.add('border-slate-200');

            toggleSingleInputs(true);
            togglePlateauInputs(false);
        }
    }

    radioMatch.addEventListener('change', updateModeDisplay);
    radioPlateau.addEventListener('change', updateModeDisplay);

    // 2. Gestion Mode Match Simple
    let isSingleNew = false;
    const btnToggleSingle = document.getElementById('btn-toggle-new-single');
    const singleExistingBox = document.getElementById('single-existing-box');
    const singleNewBox = document.getElementById('single-new-box');
    const selectSingleOpp = document.getElementById('opponent_team_id');
    const inputSingleName = document.getElementById('new_opponent_name');
    const inputSingleClub = document.getElementById('new_opponent_club');
    const inputSingleCity = document.getElementById('new_opponent_city');

    function toggleSingleInputs(enable) {
        if (!enable) {
            selectSingleOpp.disabled = true;
            selectSingleOpp.required = false;
            inputSingleName.disabled = true;
            inputSingleName.required = false;
            inputSingleClub.disabled = true;
            inputSingleCity.disabled = true;
            return;
        }

        if (isSingleNew) {
            selectSingleOpp.disabled = true;
            selectSingleOpp.required = false;
            inputSingleName.disabled = false;
            inputSingleName.required = true;
            inputSingleClub.disabled = false;
            inputSingleCity.disabled = false;
        } else {
            selectSingleOpp.disabled = false;
            selectSingleOpp.required = true;
            inputSingleName.disabled = true;
            inputSingleName.required = false;
            inputSingleClub.disabled = true;
            inputSingleCity.disabled = true;
        }
    }

    btnToggleSingle.addEventListener('click', function() {
        isSingleNew = !isSingleNew;
        if (isSingleNew) {
            singleExistingBox.classList.add('hidden');
            singleNewBox.classList.remove('hidden');
            btnToggleSingle.textContent = '← Choisir dans la liste existante';
        } else {
            singleExistingBox.classList.remove('hidden');
            singleNewBox.classList.add('hidden');
            btnToggleSingle.textContent = '+ Ajouter une équipe non listée';
        }
        toggleSingleInputs(true);
    });

    // 3. Gestion Mode Plateau Multi-équipes
    const plateauList = document.getElementById('plateau-opponents-list');
    const btnAddPlateauOpponent = document.getElementById('btn-add-plateau-opponent');
    let plateauRowCount = 0;

    function buildOpponentOptions() {
        let html = '<option value="">-- Sélectionner l\'équipe adverse --</option>';
        for (const ot of opponentTeams) {
            const loc = ot.city ? ` (${ot.city})` : '';
            html += `<option value="${ot.id}">${ot.name}${loc}</option>`;
        }
        return html;
    }

    function addPlateauRow(initialOpponentId = '') {
        plateauRowCount++;
        const rowIndex = plateauRowCount;
        const row = document.createElement('div');
        row.className = 'plateau-row p-3.5 bg-white border border-slate-200 rounded-xl space-y-3';
        row.dataset.row = rowIndex;

        row.innerHTML = `
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 row-number">Adversaire</span>
                <div class="flex items-center gap-3">
                    <button type="button" class="btn-toggle-row-new text-xs font-bold text-amber-600 hover:text-amber-700 transition">
                        + Équipe non listée
                    </button>
                    <button type="button" class="btn-remove-row text-xs font-bold text-rose-500 hover:text-rose-700 transition">
                        ✕ Retirer
                    </button>
                </div>
            </div>
            <div class="row-existing-box">
                <select name="opponent_team_ids[]" class="plateau-select w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500/20">
                    ${buildOpponentOptions()}
                </select>
            </div>
            <div class="row-new-box space-y-2 pt-2 border-t border-slate-100 hidden">
                <input type="text" name="new_opponents[${rowIndex}][name]" placeholder="Nom de l'équipe *" class="plateau-new-name w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none" disabled>
                <div class="grid grid-cols-2 gap-2">
                    <input type="text" name="new_opponents[${rowIndex}][club]" placeholder="Club (optionnel)" class="plateau-new-club w-full rounded-lg border border-slate-200 px-3 py-1.5 text-xs focus:border-amber-500 focus:outline-none" disabled>
                    <input type="text" name="new_opponents[${rowIndex}][city]" placeholder="Ville (optionnel)" class="plateau-new-city w-full rounded-lg border border-slate-200 px-3 py-1.5 text-xs focus:border-amber-500 focus:outline-none" disabled>
                </div>
            </div>
        `;

        plateauList.appendChild(row);

        const select = row.querySelector('.plateau-select');
        if (initialOpponentId) {
            select.value = String(initialOpponentId);
        }

        let isRowNew = false;
        const btnToggleRow = row.querySelector('.btn-toggle-row-new');
        const existingBox = row.querySelector('.row-existing-box');
        const newBox = row.querySelector('.row-new-box');
        const inputName = row.querySelector('.plateau-new-name');
        const inputClub = row.querySelector('.plateau-new-club');
        const inputCity = row.querySelector('.plateau-new-city');

        btnToggleRow.addEventListener('click', function() {
            isRowNew = !isRowNew;
            if (isRowNew) {
                existingBox.classList.add('hidden');
                newBox.classList.remove('hidden');
                btnToggleRow.textContent = '← Choisir dans la liste';
                select.disabled = true;
                select.required = false;
                inputName.disabled = false;
                inputName.required = true;
                inputClub.disabled = false;
                inputCity.disabled = false;
            } else {
                existingBox.classList.remove('hidden');
                newBox.classList.add('hidden');
                btnToggleRow.textContent = '+ Équipe non listée';
                select.disabled = false;
                select.required = true;
                inputName.disabled = true;
                inputName.required = false;
                inputClub.disabled = true;
                inputCity.disabled = true;
            }
        });

        const btnRemove = row.querySelector('.btn-remove-row');
        btnRemove.addEventListener('click', function() {
            const allRows = plateauList.querySelectorAll('.plateau-row');
            if (allRows.length <= 2) {
                alert('Un plateau doit comporter au moins 2 équipes adverses.');
                return;
            }
            row.remove();
            refreshPlateauRowLabels();
        });

        refreshPlateauRowLabels();
    }

    function refreshPlateauRowLabels() {
        const rows = plateauList.querySelectorAll('.plateau-row');
        rows.forEach((r, idx) => {
            const label = r.querySelector('.row-number');
            if (label) {
                label.textContent = `Adversaire ${idx + 1}`;
            }
        });
    }

    function togglePlateauInputs(enable) {
        const rows = plateauList.querySelectorAll('.plateau-row');
        rows.forEach(r => {
            const select = r.querySelector('.plateau-select');
            const isNewBoxOpen = !r.querySelector('.row-new-box').classList.contains('hidden');
            const nameInput = r.querySelector('.plateau-new-name');
            const clubInput = r.querySelector('.plateau-new-club');
            const cityInput = r.querySelector('.plateau-new-city');

            if (!enable) {
                select.disabled = true;
                select.required = false;
                nameInput.disabled = true;
                nameInput.required = false;
                clubInput.disabled = true;
                cityInput.disabled = true;
            } else {
                if (isNewBoxOpen) {
                    select.disabled = true;
                    select.required = false;
                    nameInput.disabled = false;
                    nameInput.required = true;
                    clubInput.disabled = false;
                    cityInput.disabled = false;
                } else {
                    select.disabled = false;
                    select.required = true;
                    nameInput.disabled = true;
                    nameInput.required = false;
                    clubInput.disabled = true;
                    cityInput.disabled = true;
                }
            }
        });
    }

    btnAddPlateauOpponent.addEventListener('click', function() {
        addPlateauRow();
    });

    // Pré-remplir les adversaires actuels du plateau s'il y en a
    if (currentEncounters && currentEncounters.length > 0) {
        currentEncounters.forEach(enc => {
            addPlateauRow(enc.opponent_team_id);
        });
        if (currentEncounters.length === 1) {
            // Ajouter une 2e ligne vide pour le cas où l'on bascule vers plateau
            addPlateauRow();
        }
    } else {
        addPlateauRow();
        addPlateauRow();
    }

    // Initialiser l'affichage
    updateModeDisplay();
});
</script>
{% endblock %}
